   219	
   220	def node_env() -> dict[str, str]:
   221	    values = load_secrets()
   222	    return {
   223	        **os.environ,
   224	        "MLH_TEST_ADMIN_PASSWORD": values["admin"],
   225	        "MLH_TEST_COLLECTOR_PASSWORD": values["mlh_collector"],
   226	        "MLH_TEST_NOPERM_PASSWORD": values["mlh_noperm"],
   227	    }
