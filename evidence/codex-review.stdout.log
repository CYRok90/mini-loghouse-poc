   131	    d = node.dir
   132	    secure_port = f"<tcp_port_secure>{node.tcp_secure_port}</tcp_port_secure>" if node.tls else ""
   133	    return f"""<clickhouse>
   134	    <logger><level>information</level><log>{d}/log/server.log</log><errorlog>{d}/log/error.log</errorlog><size>20M</size><count>2</count></logger>
   135	    <display_name>{node.name}</display_name>
   136	    <listen_host>{HOST}</listen_host>
   137	    <http_port>{node.http_port}</http_port>
   138	    <tcp_port>{node.tcp_port}</tcp_port>
   139	    {secure_port}
   140	    <openSSL>
   141	        <server>
   142	            <certificateFile>{CERTS}/server.pem</certificateFile>
   143	            <privateKeyFile>{CERTS}/server.key</privateKeyFile>
   144	            <verificationMode>none</verificationMode>
   145	            <loadDefaultCAFile>false</loadDefaultCAFile>
   146	        </server>
   147	        <client>
   148	            <caConfig>{CERTS}/ca.pem</caConfig>
   149	            <verificationMode>strict</verificationMode>
   150	            <loadDefaultCAFile>false</loadDefaultCAFile>
   151	        </client>
   152	    </openSSL>
   153	    <path>{d}/data/</path>
   154	    <tmp_path>{d}/tmp/</tmp_path>
   155	    <user_files_path>{d}/user_files/</user_files_path>
   156	    <default_profile>default</default_profile>
   157	    <default_database>default</default_database>
   158	    <mlock_executable>false</mlock_executable>
   159	    <max_server_memory_usage>1073741824</max_server_memory_usage>
   160	    <mark_cache_size>134217728</mark_cache_size>
   161	    <query_log>
   162	        <database>system</database>
   163	        <table>query_log</table>
   164	        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
   165	    </query_log>
   166	    {remote_servers_xml(node.cluster)}
   167	    <user_directories>
   168	        <users_xml><path>{d}/users.xml</path></users_xml>
   169	        <local_directory><path>{d}/access/</path></local_directory>
   170	    </user_directories>
   171	</clickhouse>
   172	"""
   173	
   174	
   175	def users_xml() -> str:
   176	    return """<clickhouse>
   177	    <profiles><default><log_queries>1</log_queries></default></profiles>
   178	    <quotas><default/></quotas>
   179	    <users>
