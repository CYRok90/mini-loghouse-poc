   289	def http_query(node: Node, query: str, query_id: str | None = None, timeout: float = 10) -> str:
   290	    params = {"query": query, "log_comment": "mlh-testenv"}
   291	    if query_id:
   292	        params["query_id"] = query_id
   293	    url = f"http://{HOST}:{node.http_port}/?" + urllib.parse.urlencode(params)
   294	    req = urllib.request.Request(url, method="POST")
   295	    req.add_header("X-ClickHouse-User", "admin")
   296	    req.add_header("X-ClickHouse-Key", load_secrets()["admin"])
   297	    with urllib.request.urlopen(req, timeout=timeout) as resp:  # noqa: S310 - loopback test source
   298	        return resp.read().decode()
   299	
   300	
   301	def workload(tag: str, count: int) -> None:
   302	    """Run `count` OK queries + 1 failing query per running node, with unique query_ids."""
   303	    issued: list[dict] = []
   304	    for node in NODES.values():
   305	        if not pid_of(node):
   306	            continue
   307	        for i in range(count):
   308	            qid = f"{tag}-{node.name}-ok-{i}"
   309	            http_query(node, f"SELECT sum(number) FROM numbers({100000 * (i + 1)})", qid)
   310	            issued.append({"node": node.name, "query_id": qid, "kind": "ok"})
   311	        qid = f"{tag}-{node.name}-err-0"
   312	        try:
   313	            http_query(node, "SELECT throwIf(1, 'mlh test failure')", qid)
   314	        except urllib.error.HTTPError:
   315	            pass
   316	        issued.append({"node": node.name, "query_id": qid, "kind": "error"})
   317	    print(json.dumps(issued))
   318	
   319	
   320	def main(argv: list[str]) -> int:
   321	    if len(argv) < 2:
   322	        print(__doc__)
   323	        return 2
   324	    cmd, rest = argv[1], argv[2:]
   325	    if cmd == "init":
   326	        init()
   327	    elif cmd == "start":
   328	        start(rest or list(NODES))
   329	    elif cmd == "stop":
   330	        stop(rest or list(NODES))
   331	    elif cmd == "status":
   332	        status()
   333	    elif cmd == "workload":
   334	        workload(rest[0], int(rest[1]) if len(rest) > 1 else 5)
   335	    elif cmd == "sql":
   336	        print(http_query(NODES[rest[0]], rest[1]), end="")
   337	    else:
   338	        print(__doc__)
   339	        return 2
   340	    return 0
   341	
   342	
