   111	def remote_servers_xml(own_cluster: str) -> str:
   112	    """Each node only knows its own cluster, like separately operated clusters."""
   113	    clusters: dict[str, list[Node]] = {}
   114	    for node in NODES.values():
   115	        clusters.setdefault(node.cluster, []).append(node)
   116	    parts = []
   117	    for cluster, nodes in clusters.items():
   118	        if cluster != own_cluster:
   119	            continue
   120	        shards = "".join(
   121	            f"<shard><replica><host>{HOST}</host><port>{n.native_port}</port>"
   122	            f"<secure>{1 if n.tls else 0}</secure><user>admin</user>"
   123	            f"<password from_env=\"MLH_TEST_ADMIN_PASSWORD\"/></replica></shard>"
   124	            for n in nodes
   125	        )
   126	        parts.append(f"<{cluster}>{shards}</{cluster}>")
   127	    return "<remote_servers>" + "".join(parts) + "</remote_servers>"
   128	
   129	
