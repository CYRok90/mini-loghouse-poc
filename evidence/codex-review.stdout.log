   191	# --------------------------------------------------------------------------- diagnostics
   192	def diagnostics(owner: ChdbOwner, registry: Registry, cluster: dict, prefix: str | None) -> dict[str, Any]:
   193	    """Raw vs deduplicated counts, collection objects and (optionally) the event set for a query_id prefix."""
   194	    params: dict[str, Any] = {"cid": cluster["id"]}
   195	    per_node = owner.rows(
   196	        "SELECT node_id, collect_path, count() AS raw_rows, uniqExact(event_time_microseconds, type, query_id,"
   197	        " query_start_time_microseconds) AS distinct_events FROM telemetry.query_log_raw"
   198	        " WHERE cluster_id = {cid:String} GROUP BY node_id, collect_path ORDER BY node_id, collect_path" + _LIMITS, params)
   199	    mvs = owner.rows("SELECT name FROM system.tables WHERE database = 'telemetry' AND engine = 'MaterializedView'"
   200	                     " AND (name LIKE 'mv_m_%' OR name LIKE 'mv_q_%') ORDER BY name" + _LIMITS)
   201	    node_ids = {n["id"] for n in registry.nodes(cluster["id"])}
   202	    out: dict[str, Any] = {
   203	        "per_node": per_node,
   204	        "collection_views": [m["name"] for m in mvs if m["name"][5:] in node_ids],
   205	        "cursors": {nid: registry.cursor(nid) for nid in node_ids},
   206	        "gaps": registry.gaps(sorted(node_ids)),
   207	    }
   208	    if prefix:
   209	        p = {**params, "prefix": prefix}
   210	        cond = (" WHERE cluster_id = {cid:String} AND (startsWith(query_id, {prefix:String})"
   211	                " OR startsWith(initial_query_id, {prefix:String}))")
   212	        out["prefix"] = {
   213	            "raw_rows": owner.rows("SELECT count() AS c FROM telemetry.query_log_raw" + cond + _LIMITS, p)[0]["c"],
   214	            "final_rows": owner.rows("SELECT count() AS c FROM telemetry.query_log_v" + cond + _LIMITS, p)[0]["c"],
   215	            "initial_queries": owner.rows("SELECT countIf(is_initial_query = 1 AND type != 'QueryStart') AS c"
   216	                                          " FROM telemetry.query_log_v" + cond + _LIMITS, p)[0]["c"],
   217	            "events": owner.rows(
   218	                "SELECT source_display_name AS node, query_id, type, toUnixTimestamp64Micro(event_time_microseconds) AS t,"
   219	                " is_initial_query, collect_path"
   220	                " FROM telemetry.query_log_v" + cond + " ORDER BY t LIMIT 5000" + _LIMITS, p),
   221	        }
   222	    return out

--- mlh/errors.py ---
     1	"""Map raw chDB/ClickHouse exception text to a fixed category + safe message.
     2	
     3	Raw text can contain SQL (and therefore escaped secrets, see Day-0 evidence),
     4	so it is never returned or logged. Only the category, a fixed Korean message
     5	and the numeric ClickHouse error codes leave this module.
     6	
     7	Patterns come from evidence/day0/error_detail.log (chDB 26.9 -> CH 26.8).
     8	"""
     9	
    10	from __future__ import annotations
    11	
    12	import re
    13	from dataclasses import dataclass
    14	
    15	_CODE_RE = re.compile(r"Code: (\d+)\.")
    16	
    17	
    18	@dataclass(frozen=True)
    19	class ErrorInfo:
    20	    category: str
    21	    message: str
    22	    codes: tuple[int, ...]
    23	
    24	    def to_dict(self) -> dict:
    25	        return {"category": self.category, "message": self.message, "codes": list(self.codes)}
    26	
    27	
    28	# Order matters: the first matching rule wins (most specific first).
    29	_RULES: tuple[tuple[str, re.Pattern[str], str], ...] = (
    30	    ("dns", re.compile(r"DNS_ERROR|Not found address of host"), "호스트 이름을 해석할 수 없습니다 (DNS)."),
    31	    ("tls_not_tls_endpoint", re.compile(r"SSL Exception.*wrong version number"),
    32	     "TLS로 접속했지만 서버가 TLS 응답을 하지 않았습니다. 평문 native 포트이거나 TLS 설정이 다릅니다."),
    33	    ("tls_verify", re.compile(r"certificate verify failed|CERTIFICATE_VERIFY_FAILED|unable to get local issuer", re.I),
    34	     "TLS 인증서를 검증하지 못했습니다 (CA 신뢰 설정 확인)."),
    35	    ("tls_handshake", re.compile(r"SSL Exception|SSL routines", re.I), "TLS handshake에 실패했습니다."),
    36	    ("http_endpoint", re.compile(r"Unexpected packet from server .*got 72\)"),
    37	     "native protocol이 아닌 HTTP 응답을 받았습니다. HTTP 포트가 아니라 native(TCP) 포트가 필요합니다."),
    38	    ("tls_endpoint_plain_client", re.compile(r"Unexpected packet from server .*got 2[12]\)"),
    39	     "서버가 TLS로 응답했습니다. TLS 사용을 켜고 다시 시도하세요."),
    40	    ("protocol", re.compile(r"UNEXPECTED_PACKET_FROM_SERVER|Unexpected packet from server"),
    41	     "ClickHouse native protocol 응답이 아닙니다. endpoint와 포트를 확인하세요."),
    42	    ("auth", re.compile(r"AUTHENTICATION_FAILED|Code: 516\."), "인증에 실패했습니다 (사용자 이름 또는 비밀번호)."),
    43	    ("access_denied", re.compile(r"ACCESS_DENIED|Code: 497\.|Not enough privileges"),
    44	     "system table 조회 권한이 없습니다 (ACCESS_DENIED)."),
    45	    ("table_missing", re.compile(r"There is no table|UNKNOWN_TABLE|Code: 60\."),
    46	     "필요한 system table이 없습니다 (비활성화되었거나 첫 flush 전)."),
    47	    ("column_missing", re.compile(r"UNKNOWN_IDENTIFIER|Code: 47\."),
    48	     "서버 버전에 필요한 컬럼이 없습니다 (버전 호환성)."),
    49	    ("nc_missing", re.compile(r"NAMED_COLLECTION_DOESNT_EXIST|Code: 669\."),
    50	     "저장된 자격증명(named collection)이 없습니다. 재입력이 필요합니다."),
    51	    ("refused", re.compile(r"Connection refused"), "연결이 거부되었습니다 (포트가 닫혀 있거나 서버 중지)."),
    52	    ("timeout", re.compile(r"SOCKET_TIMEOUT|Timeout: connect timed out|TIMEOUT_EXCEEDED|Timeout exceeded", re.I),
    53	     "제한 시간 안에 응답이 없습니다. (원인 미확정: 방화벽·서버 지연 외에 HTTP 등 다른 protocol 포트도 응답 없이 timeout 될 수 있음)"),
    54	    ("network", re.compile(r"NETWORK_ERROR|Connection reset|Broken pipe|Net Exception", re.I), "네트워크 오류가 발생했습니다."),
    55	)
    56	
    57	
    58	def classify(raw: str) -> ErrorInfo:
    59	    codes = tuple(dict.fromkeys(int(c) for c in _CODE_RE.findall(raw)))
    60	    for category, pattern, message in _RULES:
    61	        if pattern.search(raw):
    62	            return ErrorInfo(category, message, codes)
    63	    return ErrorInfo("unclassified", "원인을 분류할 수 없는 오류입니다 (미분류).", codes)
    64	
    65	
    66	def classify_exception(exc: BaseException) -> ErrorInfo:
    67	    return classify(str(exc))
    68	
    69	
    70	# Categories meaning "the endpoint answered as ClickHouse and authenticated".
    71	CONNECTED_CATEGORIES = frozenset({"access_denied", "table_missing", "column_missing"})

--- mlh/security.py ---
     1	"""HTTP hardening for a loopback, single-operator app.
     2	
     3	- Host header allowlist (DNS rebinding defence) -> 421.
     4	- State-changing requests need an allowed Origin, JSON content type and the
     5	  custom X-MLH-Request header. No CORS headers are ever sent, so cross-site
     6	  pages cannot read responses or send the custom header. (Council decision:
     7	  no double-submit token; there is no cookie-based auth to protect.)
     8	- Validation errors never echo the submitted input (passwords!).
     9	- Unhandled exceptions return a fixed message; raw text is not logged either,
    10	  because chDB exception text can contain SQL with escaped secrets.
    11	"""
    12	
    13	from __future__ import annotations
    14	
    15	import logging
    16	
    17	from fastapi import FastAPI, Request
    18	from fastapi.exceptions import RequestValidationError
    19	from fastapi.responses import JSONResponse
    20	
    21	log = logging.getLogger(__name__)
    22	
    23	SAFE_METHODS = {"GET", "HEAD"}
    24	CSP = ("default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; "
    25	       "frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'")
    26	
    27	
    28	def error_body(category: str, message: str, **extra) -> dict:
    29	    return {"error": {"category": category, "message": message, **extra}}
    30	
    31	
    32	def install(app: FastAPI, port: int) -> None:
    33	    hosts = {f"127.0.0.1:{port}", f"localhost:{port}"}
    34	    origins = {f"http://{h}" for h in hosts}
    35	
    36	    @app.middleware("http")
    37	    async def guard(request: Request, call_next):
    38	        if request.headers.get("host", "") not in hosts:
    39	            return JSONResponse(error_body("bad_host", "허용되지 않은 Host입니다."), status_code=421)
    40	        if request.method not in SAFE_METHODS:
    41	            if request.headers.get("origin") not in origins:
    42	                return JSONResponse(error_body("bad_origin", "허용되지 않은 Origin입니다."), status_code=403)
    43	            if request.headers.get("x-mlh-request") != "1":
    44	                return JSONResponse(error_body("missing_header", "요청 헤더가 올바르지 않습니다."), status_code=403)
    45	            ctype = request.headers.get("content-type", "").split(";")[0].strip()
    46	            if request.method != "DELETE" and ctype != "application/json":
    47	                return JSONResponse(error_body("bad_content_type", "JSON 요청만 허용됩니다."), status_code=415)
    48	        try:
    49	            response = await call_next(request)
    50	        except Exception as exc:  # noqa: BLE001 - keep raw text (may contain SQL) out of logs
    51	            log.error("unhandled %s on %s %s", type(exc).__name__, request.method, request.url.path)
    52	            response = JSONResponse(error_body("internal", "서버 내부 오류가 발생했습니다."), status_code=500)
    53	        response.headers["Content-Security-Policy"] = CSP
    54	        response.headers["X-Content-Type-Options"] = "nosniff"
    55	        response.headers["Referrer-Policy"] = "no-referrer"
    56	        response.headers["X-Frame-Options"] = "DENY"
    57	        if request.url.path.startswith("/api/"):
    58	            response.headers["Cache-Control"] = "no-store"
    59	        else:  # pages/static: always revalidate (ETag) so UI fixes are never masked by a stale cache
    60	            response.headers["Cache-Control"] = "no-cache"
    61	        return response
    62	
    63	    @app.exception_handler(RequestValidationError)
    64	    async def on_validation(_: Request, exc: RequestValidationError):
    65	        fields = [{"field": ".".join(str(p) for p in e.get("loc", ())[1:]), "message": e.get("msg", "")}
    66	                  for e in exc.errors()]
    67	        return JSONResponse(error_body("invalid_input", "입력값을 확인하세요.", fields=fields), status_code=422)
    68	
    69	    @app.exception_handler(Exception)
    70	    async def on_error(request: Request, exc: Exception):
    71	        log.error("unhandled %s on %s %s", type(exc).__name__, request.method, request.url.path)
    72	        return JSONResponse(error_body("internal", "서버 내부 오류가 발생했습니다."), status_code=500)

--- mlh/probe.py ---
     1	"""Connection / permission probe, isolated in a subprocess.
     2	
     3	Why a subprocess: chDB allows one data path per process and serialises
     4	foreground queries, so a slow remote probe inside the backend would stall the
     5	dashboard (measured 1.8 s stall for a 2 s connect timeout). The child uses an
     6	in-memory chDB with a TLS-only config, receives the password on stdin, never
     7	inherits the NC encryption key, and can be hard-killed on timeout.
     8	
     9	Child entry: python -m mlh.probe  (JSON on stdin -> JSON on stdout)
    10	"""
    11	
    12	from __future__ import annotations
    13	
    14	import json
    15	import os
    16	import subprocess
    17	import sys
    18	import time
    19	from typing import Any
    20	
    21	from .errors import CONNECTED_CATEGORIES, classify
    22	from .schema import QUERY_LOG_COLUMNS
    23	from .settings import PROJECT_ROOT, Settings
    24	from .sqlsafe import format_address, literal, parse_host
    25	
    26	MAX_CANDIDATES = 16
    27	_SETTINGS = (
    28	    "connect_timeout_with_failover_ms = 2000, connect_timeout_with_failover_secure_ms = 2000, "
    29	    "connections_with_failover_max_tries = 1, receive_timeout = 5, send_timeout = 5, max_execution_time = 5"
    30	)
    31	
    32	
    33	# --------------------------------------------------------------------------- parent side
    34	def render_probe_config(settings: Settings) -> str:
    35	    ca = settings.tls_ca_file
    36	    trust = f"<caConfig>{ca}</caConfig><loadDefaultCAFile>false</loadDefaultCAFile>" if ca else "<loadDefaultCAFile>true</loadDefaultCAFile>"
    37	    return (
    38	        "<clickhouse><openSSL><client>" + trust +
    39	        "<verificationMode>strict</verificationMode>"
    40	        "<invalidCertificateHandler><name>RejectCertificateHandler</name></invalidCertificateHandler>"
    41	        "</client></openSSL></clickhouse>\n"
    42	    )
    43	
    44	
    45	def run_probe(settings: Settings, endpoint: dict[str, Any], candidates: list[dict] | None) -> dict[str, Any]:
    46	    payload = {
    47	        **endpoint,
    48	        "candidates": candidates,
    49	        "tag": settings.collector_tag,
    50	        "config": str(settings.data_dir / "probe-config.xml"),
    51	    }
    52	    env = {k: v for k, v in os.environ.items() if not k.startswith("MLH_NC_KEY")}
    53	    timeout = settings.probe_timeout_seconds + 3 * len(candidates or [])
    54	    try:
    55	        done = subprocess.run(
    56	            [sys.executable, "-m", "mlh.probe"], input=json.dumps(payload), capture_output=True,
    57	            text=True, timeout=timeout, cwd=PROJECT_ROOT, env=env, check=False,
    58	        )
    59	    except subprocess.TimeoutExpired:
    60	        return {"fatal": {"category": "timeout", "message": "연결 검사가 제한 시간 안에 끝나지 않았습니다.", "codes": []}}
    61	    if done.returncode != 0 or not done.stdout.strip():
    62	        return {"fatal": {"category": "unclassified", "message": "연결 검사 프로세스가 비정상 종료했습니다.", "codes": []}}
    63	    return json.loads(done.stdout)
    64	
    65	
    66	def required_ok(target: dict[str, Any]) -> bool:
    67	    checks = target.get("checks", {})
    68	    return bool(target.get("connect", {}).get("ok")) and all(
    69	        checks.get(name, {}).get("ok") for name in ("metrics", "query_log")
    70	    )
    71	
    72	
    73	# --------------------------------------------------------------------------- child side
    74	def _error(exc: BaseException) -> dict[str, Any]:
    75	    info = classify(str(exc))
    76	    return {"ok": False, **info.to_dict(), "connected": info.category in CONNECTED_CATEGORIES}
    77	
    78	
    79	def _run(sess, sql: str, params: dict) -> list[dict]:
    80	    out = sess.query(sql, "JSONEachRow", params=params).bytes().decode()
    81	    return [json.loads(line) for line in out.splitlines() if line.strip()]
    82	
    83	
    84	def _source(fn: str, table: str) -> str:
    85	    return f"{fn}({{addr:String}}, system.{table}, {{u:String}}, {{p:String}})"
    86	
    87	
    88	def _probe_target(sess, target: dict, tag: str) -> dict[str, Any]:
    89	    fn = "remoteSecure" if target["tls"] else "remote"
    90	    params = {"addr": format_address(target["host"], int(target["port"])), "u": target["username"], "p": target["password"]}
    91	    settings = f"SETTINGS log_comment = {literal(tag)}, {_SETTINGS}"
    92	    started = time.monotonic()
    93	    result: dict[str, Any] = {"host": target["host"], "port": int(target["port"])}
    94	    try:
    95	        info = _run(sess, "SELECT version() AS version, displayName() AS display_name, toString(serverUUID()) AS server_uuid,"
    96	                          f" timezone() AS timezone FROM {_source(fn, 'one')} {settings}", params)[0]
    97	        result["connect"] = {"ok": True, **info}
    98	    except Exception as exc:  # noqa: BLE001 - classified, raw text dropped
    99	        err = _error(exc)
   100	        result["connect"] = err
   101	        if not err["connected"]:
   102	            result["duration_ms"] = int((time.monotonic() - started) * 1000)
   103	            return result
   104	    checks: dict[str, Any] = {}
   105	    sqls = {
   106	        "metrics": f"SELECT count() AS rows FROM {_source(fn, 'metrics')} {settings}",
   107	        "query_log": f"SELECT count() AS rows FROM (SELECT {', '.join(QUERY_LOG_COLUMNS)} FROM {_source(fn, 'query_log')}"
   108	                     f" WHERE event_date >= today() - 1 AND event_time >= now() - INTERVAL 1 HOUR) {settings}",
   109	        "clusters": f"SELECT cluster, shard_num, replica_num, host_name, port, is_local FROM {_source(fn, 'clusters')} {settings}",
   110	    }
   111	    for name, sql in sqls.items():
   112	        try:
   113	            rows = _run(sess, sql, params)
   114	            checks[name] = {"ok": True, "rows": rows if name == "clusters" else int(rows[0]["rows"])}
   115	        except Exception as exc:  # noqa: BLE001
   116	            checks[name] = _error(exc)
   117	    result["checks"] = checks
   118	    result["duration_ms"] = int((time.monotonic() - started) * 1000)
   119	    return result
   120	
   121	
   122	def _derive_candidates(endpoint_result: dict) -> list[dict]:
   123	    """Nodes of every cluster definition that contains the endpoint itself (is_local=1)."""
   124	    rows = endpoint_result.get("checks", {}).get("clusters", {}).get("rows")
   125	    if not isinstance(rows, list):
   126	        return []
   127	    local_clusters = {r["cluster"] for r in rows if int(r["is_local"]) == 1}
   128	    seen, found = set(), []
   129	    for r in rows:
   130	        try:  # server-provided names must still be a single host, never an address pattern
   131	            host = parse_host(str(r["host_name"]))
   132	        except ValueError:
   133	            continue
   134	        key = (host, int(r["port"]))
   135	        if r["cluster"] in local_clusters and int(r["is_local"]) == 0 and key not in seen:
   136	            seen.add(key)
   137	            found.append({"host": host, "port": int(r["port"]), "cluster": r["cluster"]})
   138	    return found[:MAX_CANDIDATES]
   139	
   140	
   141	def _child(payload: dict) -> dict[str, Any]:
   142	    from chdb import session as chs
   143	
   144	    config = payload["config"]
   145	    sess = chs.Session(f"file::memory:?config-file={config}")
   146	    endpoint = _probe_target(sess, payload, payload["tag"])
   147	    explicit = payload.get("candidates")
   148	    candidates = explicit if explicit is not None else _derive_candidates(endpoint)
   149	    probed = [
   150	        {**_probe_target(sess, {**payload, "host": c["host"], "port": c["port"]}, payload["tag"]), "cluster": c.get("cluster")}
   151	        for c in candidates[:MAX_CANDIDATES]
   152	    ]
   153	    sess.close()
   154	    return {"endpoint": endpoint, "candidates": probed, "candidates_source": "explicit" if explicit is not None else "system.clusters"}
   155	
   156	
   157	if __name__ == "__main__":
   158	    data = json.loads(sys.stdin.read())
   159	    sys.stdout.write(json.dumps(_child(data)))

--- mlh/sqlsafe.py ---
     1	"""Input validation and the only places where values become SQL text.
     2	
     3	Policy
     4	- Identifiers (database/table/NC names) are never user input: they are built
     5	  from server-generated hex ids and re-checked against IDENT_RE.
     6	- String literals go through query parameters `{name:String}` when the
     7	  statement supports them (SELECT, CREATE MATERIALIZED VIEW ... AS SELECT).
     8	- CREATE NAMED COLLECTION rejects parameters, so it uses `literal()`, which
     9	  rejects control characters and escapes backslash and single quote.
    10	- host is parsed as an IP address or DNS name. ClickHouse address-pattern
    11	  syntax ({a,b}, |, comma, spaces) is rejected so one form field can only ever
    12	  mean one endpoint.
    13	"""
    14	
    15	from __future__ import annotations
    16	
    17	import ipaddress
    18	import re
    19	import secrets
    20	
    21	from pydantic import BaseModel, Field, field_validator
    22	
    23	IDENT_RE = re.compile(r"^[a-z][a-z0-9_]{1,62}$")
    24	_DNS_LABEL_RE = re.compile(r"^(?!-)[A-Za-z0-9-]{1,63}(?<!-)$")
    25	
    26	
    27	def new_id(prefix: str) -> str:
    28	    return f"{prefix}{secrets.token_hex(6)}"
    29	
    30	
    31	def identifier(name: str) -> str:
    32	    if not IDENT_RE.fullmatch(name):
    33	        raise ValueError("invalid identifier")
    34	    return name
    35	
    36	
    37	def literal(value: str) -> str:
    38	    if any(ord(ch) < 0x20 or ord(ch) == 0x7F for ch in value):
    39	        raise ValueError("control characters are not allowed")
    40	    return "'" + value.replace("\\", "\\\\").replace("'", "\\'") + "'"
    41	
    42	
    43	def parse_host(value: str) -> str:
    44	    host = value.strip()
    45	    if not host or len(host) > 253:
    46	        raise ValueError("host must be 1..253 characters")
    47	    try:
    48	        return str(ipaddress.ip_address(host))
    49	    except ValueError:
    50	        pass
    51	    labels = host.rstrip(".").split(".")
    52	    if not all(_DNS_LABEL_RE.fullmatch(label) for label in labels):
    53	        raise ValueError("host must be a single IP address or DNS name (no ports, patterns or lists)")
    54	    return host.lower()
    55	
    56	
    57	def format_address(host: str, port: int) -> str:
    58	    """host:port as understood by remote()/remoteSecure() (IPv6 in brackets)."""
    59	    return f"[{host}]:{port}" if ":" in host else f"{host}:{port}"
    60	
    61	
    62	def _no_control(value: str) -> str:
    63	    if any(ord(ch) < 0x20 or ord(ch) == 0x7F for ch in value):
    64	        raise ValueError("control characters are not allowed")
    65	    return value
    66	
    67	
    68	class EndpointInput(BaseModel):
    69	    host: str = Field(min_length=1, max_length=253)
    70	    port: int = Field(ge=1, le=65535)
    71	    tls: bool
    72	    username: str = Field(min_length=1, max_length=64)
    73	    password: str = Field(min_length=1, max_length=256, repr=False)
    74	
    75	    @field_validator("host")
    76	    @classmethod
    77	    def _host(cls, value: str) -> str:
    78	        return parse_host(value)
    79	
    80	    @field_validator("username", "password")
    81	    @classmethod
    82	    def _text(cls, value: str) -> str:
    83	        return _no_control(value)
    84	
    85	
    86	class NodeAddress(BaseModel):
    87	    host: str = Field(min_length=1, max_length=253)
    88	    port: int = Field(ge=1, le=65535)
    89	
    90	    @field_validator("host")
    91	    @classmethod
    92	    def _host(cls, value: str) -> str:
    93	        return parse_host(value)
    94	
    95	
    96	class ProbeRequest(EndpointInput):
    97	    name: str = Field(min_length=1, max_length=64)
    98	
    99	    @field_validator("name")
   100	    @classmethod
   101	    def _name(cls, value: str) -> str:
   102	        return _no_control(value.strip())
   103	
   104	
   105	class RegisterRequest(ProbeRequest):
   106	    nodes: list[NodeAddress] = Field(min_length=1, max_length=32)

--- mlh/keystore.py ---
     1	"""Encryption key for chDB named collections (remote credentials).
     2	
     3	The key lives OUTSIDE the data directory (default ~/.config/mini-loghouse/nc.key)
     4	so a copied data dir alone does not reveal passwords. It is created once with
     5	O_EXCL + 0600 and is never regenerated automatically: a missing or different key
     6	puts the app into recovery mode instead of silently orphaning stored secrets.
     7	"""
     8	
     9	from __future__ import annotations
    10	
    11	import hashlib
    12	import os
    13	import re
    14	import secrets
    15	import stat
    16	from dataclasses import dataclass
    17	from pathlib import Path
    18	
    19	_KEY_RE = re.compile(r"^[0-9a-f]{32}$")
    20	
    21	
    22	class KeyError_(Exception):
    23	    """Key file problem that requires operator action (recovery mode)."""
    24	
    25	
    26	@dataclass(frozen=True)
    27	class KeyMaterial:
    28	    key_hex: str = ""
    29	
    30	    @property
    31	    def fingerprint(self) -> str:
    32	        return hashlib.sha256(("mlh-nc:" + self.key_hex).encode()).hexdigest()[:16]
    33	
    34	    def __repr__(self) -> str:  # never print the key
    35	        return f"KeyMaterial(fingerprint={self.fingerprint})"
    36	
    37	
    38	def _check_private(path: Path) -> None:
    39	    mode = stat.S_IMODE(path.stat().st_mode)
    40	    if mode & 0o077:
    41	        raise KeyError_(f"key file permissions must be 0600 (found {oct(mode)})")
    42	
    43	
    44	def create_key(path: Path) -> KeyMaterial:
    45	    path.parent.mkdir(parents=True, exist_ok=True)
    46	    os.chmod(path.parent, 0o700)
    47	    key_hex = secrets.token_hex(16)
    48	    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    49	    with os.fdopen(fd, "w") as fh:
    50	        fh.write(key_hex + "\n")
    51	    return KeyMaterial(key_hex)
    52	
    53	
    54	def load_key(path: Path) -> KeyMaterial:
    55	    if not path.exists():
    56	        raise KeyError_("key file is missing")
    57	    _check_private(path)
    58	    key_hex = path.read_text().strip()
    59	    if not _KEY_RE.fullmatch(key_hex):
    60	        raise KeyError_("key file content is not a 128-bit hex key")
    61	    return KeyMaterial(key_hex)
    62	
    63	
    64	def load_or_create(path: Path, expected_fingerprint: str | None) -> KeyMaterial:
    65	    """Create the key only for a brand-new installation (no fingerprint recorded)."""
    66	    if not path.exists() and expected_fingerprint is None:
    67	        return create_key(path)
    68	    material = load_key(path)
    69	    if expected_fingerprint is not None and material.fingerprint != expected_fingerprint:
    70	        raise KeyError_("key fingerprint does not match the one recorded for this data directory")
    71	    return material

