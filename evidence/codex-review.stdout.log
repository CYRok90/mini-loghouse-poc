   108	
   109	def _rt(app: FastAPI) -> Runtime:
   110	    return app.state.runtime
   111	
   112	
   113	def _require_owner(rt: Runtime) -> ChdbOwner:
   114	    if rt.owner is None:
   115	        raise HTTPException(503, detail=rt.recovery_reason or "recovery mode")
   116	    return rt.owner
   117	
   118	
   119	def _cluster_or_404(rt: Runtime, cluster_id: str) -> dict[str, Any]:
   120	    cluster = rt.registry.cluster(cluster_id) if CLUSTER_ID_RE.fullmatch(cluster_id) else None
   121	    if cluster is None:
   122	        raise HTTPException(404, detail="cluster not found")
   123	    return cluster
   124	
   125	
   126	def _api(app: FastAPI, settings: Settings) -> None:
   127	    @app.get("/api/health")
   128	    async def health() -> dict:
   129	        rt = _rt(app)
   130	        return {
   131	            "mode": "recovery" if rt.owner is None else "normal", "recovery_reason": rt.recovery_reason,
   132	            "refresh_seconds": settings.refresh_seconds, "stale_after_seconds": settings.stale_after_seconds,
   133	            "safety_lag_seconds": settings.safety_lag_seconds, "overlap_seconds": settings.overlap_seconds,
   134	            "credential_policy": "encrypted_named_collection",
   135	        }
   136	
   137	    @app.post("/api/probe")
   138	    async def probe(body: ProbeBody) -> dict:
   139	        _require_owner(_rt(app))
   140	        candidates = [c.model_dump() for c in body.candidates] if body.candidates is not None else None
   141	        result = await run_in_threadpool(run_probe, settings, endpoint_payload(body), candidates)
   142	        return summarize(result)
   143	
   144	    @app.post("/api/clusters", status_code=201)
   145	    async def create_cluster(body: RegisterRequest) -> JSONResponse:
   146	        rt = _rt(app)
   147	        owner = _require_owner(rt)
   148	        async with app.state.register_lock:  # double-click / resend cannot race the unique checks
   149	            try:
   150	                cluster_id = await run_in_threadpool(register, owner, rt.registry, settings, body)
   151	            except RegistrationError as exc:
   152	                body_ = security.error_body(exc.category, exc.message, probe=exc.detail)
   153	                return JSONResponse(body_, status_code=exc.status)
   154	        return JSONResponse({"id": cluster_id}, status_code=201)
   155	
   156	    @app.get("/api/clusters")
   157	    async def list_clusters() -> dict:
   158	        rt = _rt(app)
   159	        views = [dashboard.cluster_view(rt.registry, settings, c) for c in rt.registry.clusters()]
   160	        return {"mode": "recovery" if rt.owner is None else "normal", "clusters": views}
   161	
   162	    @app.get("/api/clusters/{cluster_id}")
   163	    async def get_cluster(cluster_id: str) -> dict:
   164	        rt = _rt(app)
   165	        cluster = _cluster_or_404(rt, cluster_id)
   166	        view = dashboard.cluster_view(rt.registry, settings, cluster)
   167	        node_ids = [n["id"] for n in view["nodes"]]
   168	        return {**view, "transitions": rt.registry.transitions(node_ids, 30)}
   169	
   170	    @app.get("/api/clusters/{cluster_id}/dashboard")
   171	    async def get_dashboard(cluster_id: str, range: str = Query("1h", pattern="^(15m|1h|24h)$"),
   172	                            node: str | None = Query(None)) -> dict:
   173	        rt = _rt(app)
   174	        owner = _require_owner(rt)
   175	        cluster = _cluster_or_404(rt, cluster_id)
   176	        if node is not None and (not NODE_ID_RE.fullmatch(node) or node not in {n["id"] for n in rt.registry.nodes(cluster_id)}):
   177	            raise HTTPException(400, detail="unknown node")
   178	        return await run_in_threadpool(dashboard.dashboard, owner, rt.registry, settings, cluster, range, node)
   179	
   180	    @app.get("/api/clusters/{cluster_id}/diagnostics")
   181	    async def get_diagnostics(cluster_id: str, prefix: str | None = Query(None, pattern=r"^[A-Za-z0-9_\-]{1,64}$")) -> dict:
   182	        rt = _rt(app)
   183	        owner = _require_owner(rt)
   184	        cluster = _cluster_or_404(rt, cluster_id)
   185	        return await run_in_threadpool(dashboard.diagnostics, owner, rt.registry, cluster, prefix)
   186	
   187	    @app.delete("/api/clusters/{cluster_id}")
   188	    async def delete_cluster(cluster_id: str) -> dict:
   189	        rt = _rt(app)
   190	        owner = _require_owner(rt)
   191	        _cluster_or_404(rt, cluster_id)
   192	        async with app.state.register_lock:
   193	            await run_in_threadpool(provisioner.delete_cluster, owner, rt.registry, cluster_id)
   194	        return {"deleted": cluster_id}

--- mlh/chdb_owner.py ---
     1	"""Single owner of the persistent chDB instance in this process.
     2	
     3	- An exclusive flock on <data_dir>/app.lock is taken BEFORE chDB is opened and
     4	  held for the process lifetime, so a second backend (another terminal, a
     5	  dev reload, a second worker) exits instead of running duplicate RMVs.
     6	- chDB serialises foreground queries across sessions of one path (measured),
     7	  so every call goes through one worker thread. RMV refreshes run in chDB's
     8	  own background pool and are not blocked by this executor.
     9	- The NC encryption key reaches chDB only through this process's environment
    10	  (`key_hex from_env`); it is not written to the generated config file.
    11	"""
    12	
    13	from __future__ import annotations
    14	
    15	import fcntl
    16	import json
    17	import logging
    18	import os
    19	from concurrent.futures import ThreadPoolExecutor
    20	from pathlib import Path
    21	from typing import Any
    22	
    23	from chdb import session as chs
    24	
    25	from .keystore import KeyMaterial
    26	from .settings import Settings
    27	
    28	log = logging.getLogger(__name__)
    29	
    30	KEY_ENV = "MLH_NC_KEY_HEX"
    31	
    32	
    33	class AlreadyRunning(RuntimeError):
    34	    pass
    35	
    36	
    37	def acquire_lock(path: Path) -> int:
    38	    path.parent.mkdir(parents=True, exist_ok=True)
    39	    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
    40	    try:
    41	        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    42	    except BlockingIOError as exc:
    43	        os.close(fd)
    44	        raise AlreadyRunning(f"another mini-loghouse backend holds {path}") from exc
    45	    os.ftruncate(fd, 0)
    46	    os.write(fd, str(os.getpid()).encode())
    47	    return fd
    48	
    49	
    50	def render_config(settings: Settings) -> str:
    51	    ca = settings.tls_ca_file
    52	    tls_client = (
    53	        f"<caConfig>{ca}</caConfig><loadDefaultCAFile>false</loadDefaultCAFile>"
    54	        if ca else "<loadDefaultCAFile>true</loadDefaultCAFile>"
    55	    )
    56	    return f"""<clickhouse>
    57	    <!-- generated by mini-loghouse; contains no secrets -->
    58	    <named_collections_storage>
    59	        <type>local_encrypted</type>
    60	        <algorithm>aes_128_ctr</algorithm>
    61	        <key_hex from_env="{KEY_ENV}"/>
    62	    </named_collections_storage>
    63	    <openSSL><client>
    64	        {tls_client}
    65	        <verificationMode>strict</verificationMode>
    66	        <invalidCertificateHandler><name>RejectCertificateHandler</name></invalidCertificateHandler>
    67	    </client></openSSL>
    68	</clickhouse>
    69	"""
    70	
    71	
    72	def write_private(path: Path, content: str) -> None:
    73	    tmp = path.with_suffix(path.suffix + ".tmp")
    74	    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    75	    with os.fdopen(fd, "w") as fh:
    76	        fh.write(content)
    77	    os.replace(tmp, path)
    78	
    79	
    80	class ChdbOwner:
    81	    def __init__(self, settings: Settings, key: KeyMaterial) -> None:
    82	        self._settings = settings
    83	        settings.data_dir.mkdir(parents=True, exist_ok=True)
    84	        os.chmod(settings.data_dir, 0o700)
    85	        self._lock_fd = acquire_lock(settings.lock_path)
    86	        write_private(settings.chdb_config_path, render_config(settings))
    87	        os.environ[KEY_ENV] = key.key_hex
    88	        self._executor = ThreadPoolExecutor(max_workers=1, thread_name_prefix="chdb")
    89	        self._session = self._executor.submit(self._open).result()
    90	
    91	    def _open(self) -> chs.Session:
    92	        conn = f"file:{self._settings.chdb_path}?config-file={self._settings.chdb_config_path}"
    93	        return chs.Session(conn)
    94	
    95	    def _rows(self, sql: str, params: dict | None) -> list[dict[str, Any]]:
    96	        out = self._session.query(sql, "JSONEachRow", params=params).bytes().decode()
    97	        return [json.loads(line) for line in out.splitlines() if line.strip()]
    98	
    99	    def _execute(self, sql: str, params: dict | None) -> None:
   100	        self._session.query(sql, "TSV", params=params)
   101	
   102	    def rows(self, sql: str, params: dict | None = None) -> list[dict[str, Any]]:
   103	        return self._executor.submit(self._rows, sql, params).result()
   104	
   105	    def execute(self, sql: str, params: dict | None = None) -> None:
   106	        self._executor.submit(self._execute, sql, params).result()
   107	
   108	    def close(self) -> None:
   109	        try:
   110	            self._executor.submit(self._session.close).result()
   111	        finally:
   112	            self._executor.shutdown(wait=True)
   113	            os.environ.pop(KEY_ENV, None)
   114	            os.close(self._lock_fd)

--- mlh/registration.py ---
     1	"""Probe result shaping and the register-cluster flow.
     2	
     3	The browser's probe result is never trusted for saving: registration re-probes
     4	every selected node on the server, keeps only nodes that pass the required
     5	checks (connect + system.metrics + system.query_log), de-duplicates addresses
     6	that point at the same server (serverUUID), then provisions NC + RMVs.
     7	"""
     8	
     9	from __future__ import annotations
    10	
    11	from dataclasses import dataclass
    12	from typing import Any
    13	
    14	from . import provisioner
    15	from .chdb_owner import ChdbOwner
    16	from .probe import required_ok, run_probe
    17	from .registry import DuplicateError, Registry
    18	from .settings import Settings
    19	from .sqlsafe import RegisterRequest, new_id
    20	
    21	
    22	class RegistrationError(Exception):
    23	    def __init__(self, status: int, category: str, message: str, detail: Any = None) -> None:
    24	        super().__init__(message)
    25	        self.status, self.category, self.message, self.detail = status, category, message, detail
    26	
    27	
    28	@dataclass(frozen=True)
    29	class Discovery:
    30	    cluster_name: str | None
    31	    candidate_count: int
    32	
    33	
    34	def endpoint_payload(req: RegisterRequest | Any) -> dict[str, Any]:
    35	    return {"host": req.host, "port": req.port, "tls": req.tls, "username": req.username, "password": req.password}
    36	
    37	
    38	def discovery(result: dict[str, Any]) -> Discovery:
    39	    rows = result.get("endpoint", {}).get("checks", {}).get("clusters", {}).get("rows")
    40	    if not isinstance(rows, list):
    41	        return Discovery(None, 0)
    42	    local = sorted({r["cluster"] for r in rows if int(r["is_local"]) == 1})
    43	    if not local:
    44	        return Discovery(None, 0)
    45	    members = {(r["host_name"], int(r["port"])) for r in rows if r["cluster"] in local}
    46	    return Discovery(",".join(local), len(members))
    47	
    48	
    49	def summarize(result: dict[str, Any]) -> dict[str, Any]:
    50	    """Browser-facing probe result. Contains no password (the child never echoes it)."""
    51	    if "fatal" in result:
    52	        return {"ok": False, "fatal": result["fatal"]}
    53	    endpoint = result["endpoint"]
    54	    found = discovery(result)
    55	    return {
    56	        "ok": required_ok(endpoint), "endpoint": endpoint,
    57	        "candidates": [{**c, "required_ok": required_ok(c)} for c in result.get("candidates", [])],
    58	        "candidates_source": result.get("candidates_source"),
    59	        "discovered_cluster": found.cluster_name, "candidate_count": found.candidate_count,
    60	    }
    61	
    62	
    63	def _verified_nodes(result: dict[str, Any]) -> list[dict[str, Any]]:
    64	    targets = [result["endpoint"], *result.get("candidates", [])]
    65	    seen_uuid: set[str] = set()
    66	    nodes = []
    67	    for target in targets:
    68	        if not required_ok(target):
    69	            continue
    70	        info = target["connect"]
    71	        if info["server_uuid"] in seen_uuid:
    72	            continue  # two addresses for the same server: collect once
    73	        seen_uuid.add(info["server_uuid"])
    74	        nodes.append({"host": target["host"], "port": target["port"], "display_name": info["display_name"],
    75	                      "server_uuid": info["server_uuid"], "server_version": info["version"]})
    76	    return nodes
    77	
    78	
    79	def register(owner: ChdbOwner, registry: Registry, settings: Settings, req: RegisterRequest) -> str:
    80	    endpoint = endpoint_payload(req)
    81	    others = [n.model_dump() for n in req.nodes if (n.host, n.port) != (req.host, req.port)]
    82	    result = run_probe(settings, endpoint, others)
    83	    shaped = summarize(result)
    84	    if not shaped["ok"]:
    85	        raise RegistrationError(400, "probe_failed", "endpoint의 연결 또는 필수 권한 검사를 통과하지 못했습니다.", shaped)
    86	    verified = _verified_nodes(result)
    87	    found = Discovery(shaped["discovered_cluster"], shaped["candidate_count"])
    88	    cluster_id = new_id("c")
    89	    cluster = {
    90	        "id": cluster_id, "name": req.name, "host": req.host, "port": req.port, "tls": int(req.tls),
    91	        "username": req.username, "discovered_cluster": found.cluster_name,
    92	        "candidate_count": found.candidate_count or len(verified),
    93	        "server_version": result["endpoint"]["connect"]["version"],
    94	    }
    95	    nodes = [{**n, "id": new_id("n"), "cluster_id": cluster_id} for n in verified]
    96	    try:
    97	        registry.insert_cluster(cluster, nodes)
    98	    except DuplicateError as exc:
    99	        raise RegistrationError(409, "duplicate", "이미 등록된 endpoint/계정 또는 노드입니다.") from exc
   100	    provisioner.provision(owner, registry, settings, registry.cluster(cluster_id), req.password)
   101	    return cluster_id

--- mlh/registry.py ---
     1	"""Registration metadata, collection cursors, gaps and status in SQLite.
     2	
     3	SQLite holds everything except telemetry and secrets: the app can still show
     4	registrations, last status and gap history when chDB cannot be opened (for
     5	example in key recovery mode). Passwords are never stored here.
     6	All timestamps are epoch seconds (UTC).
     7	"""
     8	
     9	from __future__ import annotations
    10	
    11	import sqlite3
    12	import threading
    13	import time
    14	from contextlib import contextmanager
    15	from pathlib import Path
    16	from typing import Any, Iterator
    17	
    18	SCHEMA = """
    19	CREATE TABLE IF NOT EXISTS meta (key TEXT PRIMARY KEY, value TEXT NOT NULL);
    20	CREATE TABLE IF NOT EXISTS clusters (
    21	    id TEXT PRIMARY KEY, name TEXT NOT NULL, host TEXT NOT NULL, port INTEGER NOT NULL,
    22	    tls INTEGER NOT NULL, username TEXT NOT NULL, phase TEXT NOT NULL,
    23	    discovered_cluster TEXT, candidate_count INTEGER NOT NULL DEFAULT 0,
    24	    server_version TEXT, last_check_at REAL, last_check_ok INTEGER, last_check_category TEXT,
    25	    created_at REAL NOT NULL,
    26	    UNIQUE (host, port, username)
    27	);
    28	CREATE TABLE IF NOT EXISTS nodes (
    29	    id TEXT PRIMARY KEY, cluster_id TEXT NOT NULL REFERENCES clusters(id),
    30	    host TEXT NOT NULL, port INTEGER NOT NULL, display_name TEXT, server_uuid TEXT,
    31	    server_version TEXT, phase TEXT NOT NULL, last_error_category TEXT, last_error_message TEXT,
    32	    created_at REAL NOT NULL,
    33	    UNIQUE (host, port)
    34	);
    35	CREATE UNIQUE INDEX IF NOT EXISTS nodes_server_uuid ON nodes(server_uuid) WHERE server_uuid IS NOT NULL;
    36	CREATE TABLE IF NOT EXISTS source_status (
    37	    node_id TEXT NOT NULL, source TEXT NOT NULL, state TEXT NOT NULL,
    38	    last_attempt_at REAL, last_success_at REAL, last_error_category TEXT, last_error_message TEXT,
    39	    last_error_codes TEXT, consecutive_failures INTEGER NOT NULL DEFAULT 0, updated_at REAL NOT NULL,
    40	    PRIMARY KEY (node_id, source)
    41	);
    42	CREATE TABLE IF NOT EXISTS cursors (
    43	    node_id TEXT PRIMARY KEY, first_lo INTEGER NOT NULL, committed_hi INTEGER NOT NULL, updated_at REAL NOT NULL
    44	);
    45	CREATE TABLE IF NOT EXISTS gaps (
    46	    id INTEGER PRIMARY KEY AUTOINCREMENT, node_id TEXT NOT NULL, lo INTEGER NOT NULL, hi INTEGER NOT NULL,
    47	    next_lo INTEGER NOT NULL, state TEXT NOT NULL, reason TEXT NOT NULL, attempts INTEGER NOT NULL DEFAULT 0,
    48	    created_at REAL NOT NULL, updated_at REAL NOT NULL
    49	);
    50	CREATE TABLE IF NOT EXISTS transitions (
    51	    id INTEGER PRIMARY KEY AUTOINCREMENT, node_id TEXT NOT NULL, source TEXT NOT NULL,
    52	    from_state TEXT, to_state TEXT NOT NULL, detail TEXT, at REAL NOT NULL
    53	);
    54	"""
    55	
    56	DuplicateError = sqlite3.IntegrityError
    57	
    58	
    59	class Registry:
    60	    def __init__(self, path: Path) -> None:
    61	        path.parent.mkdir(parents=True, exist_ok=True)
    62	        self._conn = sqlite3.connect(path, check_same_thread=False, isolation_level=None)
    63	        self._conn.row_factory = sqlite3.Row
    64	        self._lock = threading.RLock()
    65	        with self._lock:
    66	            self._conn.execute("PRAGMA journal_mode=WAL")
    67	            self._conn.execute("PRAGMA foreign_keys=ON")
    68	            self._conn.executescript(SCHEMA)
    69	
    70	    @contextmanager
    71	    def tx(self) -> Iterator[sqlite3.Connection]:
    72	        with self._lock:
    73	            self._conn.execute("BEGIN IMMEDIATE")
    74	            try:
    75	                yield self._conn
    76	            except BaseException:
    77	                self._conn.execute("ROLLBACK")
    78	                raise
    79	            self._conn.execute("COMMIT")
    80	
    81	    def rows(self, sql: str, args: tuple = ()) -> list[dict[str, Any]]:
    82	        with self._lock:
    83	            return [dict(r) for r in self._conn.execute(sql, args).fetchall()]
    84	
    85	    def one(self, sql: str, args: tuple = ()) -> dict[str, Any] | None:
    86	        found = self.rows(sql, args)
    87	        return found[0] if found else None
    88	
    89	    # --- meta -------------------------------------------------------------
    90	    def get_meta(self, key: str) -> str | None:
    91	        row = self.one("SELECT value FROM meta WHERE key = ?", (key,))
    92	        return row["value"] if row else None
    93	
    94	    def set_meta(self, key: str, value: str) -> None:
    95	        with self.tx() as c:
    96	            c.execute("INSERT INTO meta(key, value) VALUES (?, ?) ON CONFLICT(key) DO UPDATE SET value=excluded.value",
    97	                      (key, value))
    98	
    99	    # --- clusters / nodes ---------------------------------------------------
   100	    def insert_cluster(self, cluster: dict[str, Any], nodes: list[dict[str, Any]]) -> None:
   101	        """Insert a cluster and its nodes atomically; raises DuplicateError on re-registration."""
   102	        now = time.time()
   103	        with self.tx() as c:
   104	            c.execute(
   105	                "INSERT INTO clusters(id, name, host, port, tls, username, phase, discovered_cluster, candidate_count,"
   106	                " server_version, last_check_at, last_check_ok, last_check_category, created_at)"
   107	                " VALUES (:id, :name, :host, :port, :tls, :username, 'provisioning', :discovered_cluster,"
   108	                " :candidate_count, :server_version, :now, 1, NULL, :now)",
   109	                {**cluster, "now": now},
   110	            )
   111	            for node in nodes:
   112	                c.execute(
   113	                    "INSERT INTO nodes(id, cluster_id, host, port, display_name, server_uuid, server_version, phase, created_at)"
   114	                    " VALUES (:id, :cluster_id, :host, :port, :display_name, :server_uuid, :server_version, 'pending', :now)",
   115	                    {**node, "now": now},
   116	                )
   117	
   118	    def clusters(self) -> list[dict[str, Any]]:
   119	        return self.rows("SELECT * FROM clusters WHERE phase != 'deleted' ORDER BY created_at")
   120	
   121	    def cluster(self, cluster_id: str) -> dict[str, Any] | None:
   122	        return self.one("SELECT * FROM clusters WHERE id = ? AND phase != 'deleted'", (cluster_id,))
   123	
   124	    def nodes(self, cluster_id: str | None = None) -> list[dict[str, Any]]:
   125	        if cluster_id is None:
   126	            return self.rows("SELECT n.* FROM nodes n JOIN clusters c ON c.id = n.cluster_id"
   127	                             " WHERE c.phase != 'deleted' ORDER BY n.created_at")
   128	        return self.rows("SELECT * FROM nodes WHERE cluster_id = ? ORDER BY created_at, host, port", (cluster_id,))
   129	
   130	    def set_cluster_phase(self, cluster_id: str, phase: str) -> None:
   131	        with self.tx() as c:
   132	            c.execute("UPDATE clusters SET phase = ? WHERE id = ?", (phase, cluster_id))
   133	
   134	    def set_node_phase(self, node_id: str, phase: str, category: str | None = None, message: str | None = None) -> None:
   135	        with self.tx() as c:
   136	            c.execute("UPDATE nodes SET phase = ?, last_error_category = ?, last_error_message = ? WHERE id = ?",
   137	                      (phase, category, message, node_id))
   138	
   139	    def record_check(self, cluster_id: str, ok: bool, category: str | None) -> None:
   140	        with self.tx() as c:
   141	            c.execute("UPDATE clusters SET last_check_at = ?, last_check_ok = ?, last_check_category = ? WHERE id = ?",
   142	                      (time.time(), int(ok), category, cluster_id))
   143	
   144	    # --- status -------------------------------------------------------------
   145	    def source_status(self, node_id: str, source: str) -> dict[str, Any] | None:
   146	        return self.one("SELECT * FROM source_status WHERE node_id = ? AND source = ?", (node_id, source))
   147	
   148	    def all_source_status(self) -> list[dict[str, Any]]:
   149	        return self.rows("SELECT * FROM source_status")
   150	
   151	    def upsert_source_status(self, status: dict[str, Any]) -> None:
   152	        """Write the latest status; append a transition row only when the state changes."""
   153	        previous = self.source_status(status["node_id"], status["source"])
   154	        now = time.time()
   155	        with self.tx() as c:
   156	            c.execute(
   157	                "INSERT INTO source_status(node_id, source, state, last_attempt_at, last_success_at,"
   158	                " last_error_category, last_error_message, last_error_codes, consecutive_failures, updated_at)"
   159	                " VALUES (:node_id, :source, :state, :last_attempt_at, :last_success_at, :last_error_category,"
   160	                " :last_error_message, :last_error_codes, :consecutive_failures, :now)"
   161	                " ON CONFLICT(node_id, source) DO UPDATE SET state=excluded.state,"
   162	                " last_attempt_at=excluded.last_attempt_at, last_success_at=excluded.last_success_at,"
   163	                " last_error_category=excluded.last_error_category, last_error_message=excluded.last_error_message,"
   164	                " last_error_codes=excluded.last_error_codes, consecutive_failures=excluded.consecutive_failures,"
   165	                " updated_at=excluded.updated_at",
   166	                {**status, "now": now},
   167	            )
   168	            prev_state = previous["state"] if previous else None
   169	            if prev_state != status["state"]:
   170	                c.execute(
   171	                    "INSERT INTO transitions(node_id, source, from_state, to_state, detail, at) VALUES (?, ?, ?, ?, ?, ?)",
   172	                    (status["node_id"], status["source"], prev_state, status["state"], status.get("last_error_category"), now),
   173	                )
   174	
   175	    def transitions(self, node_ids: list[str], limit: int = 50) -> list[dict[str, Any]]:
   176	        if not node_ids:
   177	            return []
   178	        marks = ",".join("?" for _ in node_ids)
   179	        return self.rows(f"SELECT * FROM transitions WHERE node_id IN ({marks}) ORDER BY at DESC LIMIT ?",
   180	                         (*node_ids, limit))
   181	
   182	    # --- cursors / gaps -----------------------------------------------------
   183	    def cursor(self, node_id: str) -> dict[str, Any] | None:
   184	        return self.one("SELECT * FROM cursors WHERE node_id = ?", (node_id,))
   185	
   186	    def save_cursor(self, node_id: str, first_lo: int, committed_hi: int) -> None:
   187	        with self.tx() as c:
   188	            c.execute(
   189	                "INSERT INTO cursors(node_id, first_lo, committed_hi, updated_at) VALUES (?, ?, ?, ?)"
   190	                " ON CONFLICT(node_id) DO UPDATE SET committed_hi = max(cursors.committed_hi, excluded.committed_hi),"
   191	                " updated_at = excluded.updated_at",
   192	                (node_id, first_lo, committed_hi, time.time()),
   193	            )
   194	
   195	    def add_gap(self, node_id: str, lo: int, hi: int, state: str, reason: str) -> None:
   196	        if hi <= lo:
   197	            return
   198	        now = time.time()
   199	        with self.tx() as c:
   200	            c.execute("INSERT INTO gaps(node_id, lo, hi, next_lo, state, reason, created_at, updated_at)"
   201	                      " VALUES (?, ?, ?, ?, ?, ?, ?, ?)", (node_id, lo, hi, lo, state, reason, now, now))
   202	
   203	    def gaps(self, node_ids: list[str], states: tuple[str, ...] | None = None) -> list[dict[str, Any]]:
   204	        if not node_ids:
   205	            return []
   206	        marks = ",".join("?" for _ in node_ids)
   207	        sql = f"SELECT * FROM gaps WHERE node_id IN ({marks})"
   208	        args: tuple = tuple(node_ids)
   209	        if states:
   210	            sql += f" AND state IN ({','.join('?' for _ in states)})"
   211	            args += states
   212	        return self.rows(sql + " ORDER BY lo", args)
   213	
   214	    def update_gap(self, gap_id: int, next_lo: int, state: str, attempts: int) -> None:
   215	        """Progress a gap; the original [lo, hi) is kept for coverage reporting."""
   216	        with self.tx() as c:
   217	            c.execute("UPDATE gaps SET next_lo = ?, state = ?, attempts = ?, updated_at = ? WHERE id = ?",
   218	                      (next_lo, state, attempts, time.time(), gap_id))

--- mlh/provisioner.py ---
     1	"""Create / reconcile / delete per-node collection objects in chDB.
     2	
     3	Order per node: NC (secret, local only) -> metrics RMV -> query_log RMV.
     4	RMV creation fetches the remote table structure (Day-0: fails with 519 when
     5	the source is unreachable), so a node whose RMVs could not be created stays in
     6	phase 'retrying' and the supervisor retries without needing the password again
     7	(it is already inside the encrypted NC).
     8	"""
     9	
    10	from __future__ import annotations
    11	
    12	import logging
    13	from typing import Any
    14	
    15	from . import schema
    16	from .chdb_owner import ChdbOwner
    17	from .errors import classify_exception
    18	from .registry import Registry
    19	from .settings import Settings
    20	
    21	log = logging.getLogger(__name__)
    22	
    23	
    24	def create_rmvs(owner: ChdbOwner, settings: Settings, node: dict[str, Any], tls: bool) -> None:
    25	    for build in (schema.metrics_mv_sql, schema.query_log_mv_sql):
    26	        sql, params = build(settings, node["cluster_id"], node["id"], tls)
    27	        owner.execute(sql, params)
    28	
    29	
    30	def _activate(owner: ChdbOwner, registry: Registry, settings: Settings, node: dict, tls: bool) -> bool:
    31	    try:
    32	        create_rmvs(owner, settings, node, tls)
    33	    except Exception as exc:  # noqa: BLE001 - classified; raw text may contain SQL
    34	        info = classify_exception(exc)
    35	        registry.set_node_phase(node["id"], "retrying", info.category, info.message)
    36	        log.warning("node %s rmv creation failed: %s %s", node["id"], info.category, list(info.codes))
    37	        return False
    38	    registry.set_node_phase(node["id"], "active")
    39	    return True
    40	
    41	
    42	def provision(owner: ChdbOwner, registry: Registry, settings: Settings, cluster: dict, password: str) -> None:
    43	    tls = bool(cluster["tls"])
    44	    for node in registry.nodes(cluster["id"]):
    45	        try:
    46	            owner.execute(schema.create_nc_sql(node["id"], node["host"], node["port"], cluster["username"], password))
    47	        except Exception as exc:  # noqa: BLE001
    48	            info = classify_exception(exc)
    49	            registry.set_node_phase(node["id"], "needs_credentials", info.category, "자격증명 저장에 실패했습니다.")
    50	            continue
    51	        _activate(owner, registry, settings, node, tls)
    52	    registry.set_cluster_phase(cluster["id"], "active")
    53	
    54	
    55	def existing_objects(owner: ChdbOwner) -> tuple[set[str], set[str]]:
    56	    ncs = {r["name"] for r in owner.rows("SELECT name FROM system.named_collections")}
    57	    mvs = {r["name"] for r in owner.rows(
    58	        "SELECT name FROM system.tables WHERE database = {db:String} AND engine = 'MaterializedView'", {"db": schema.DB})}
    59	    return ncs, mvs
    60	
    61	
    62	def reconcile(owner: ChdbOwner, registry: Registry, settings: Settings) -> None:
    63	    """Startup: compare SQLite registrations with chDB NCs/RMVs (no remote calls if all present)."""
    64	    for stmt in schema.BOOTSTRAP:
    65	        owner.execute(stmt)
    66	    ncs, mvs = existing_objects(owner)
    67	    for cluster in registry.clusters():
    68	        for node in registry.nodes(cluster["id"]):
    69	            if schema.nc_name(node["id"]) not in ncs:
    70	                registry.set_node_phase(node["id"], "needs_credentials", "nc_missing",
    71	                                        "저장된 자격증명이 없습니다. 재입력이 필요합니다.")
    72	                continue
    73	            wanted = {schema.metrics_mv(node["id"]), schema.query_log_mv(node["id"])}
    74	            if not wanted <= mvs:
    75	                _activate(owner, registry, settings, node, bool(cluster["tls"]))
    76	            elif node["phase"] != "active":
    77	                registry.set_node_phase(node["id"], "active")
    78	        if cluster["phase"] == "provisioning":
    79	            registry.set_cluster_phase(cluster["id"], "active")
    80	
    81	
    82	def retry(owner: ChdbOwner, registry: Registry, settings: Settings, node: dict) -> bool:
    83	    cluster = registry.cluster(node["cluster_id"])
    84	    return bool(cluster) and _activate(owner, registry, settings, node, bool(cluster["tls"]))
    85	
    86	
    87	def delete_cluster(owner: ChdbOwner, registry: Registry, cluster_id: str) -> None:
    88	    """Stop collection first (drop RMVs), then secrets (NCs), then registry rows."""
    89	    nodes = registry.nodes(cluster_id)
    90	    for node in nodes:
    91	        owner.execute(schema.drop_mv_sql(schema.metrics_mv(node["id"])))
    92	        owner.execute(schema.drop_mv_sql(schema.query_log_mv(node["id"])))
    93	    for node in nodes:
    94	        owner.execute(schema.drop_nc_sql(node["id"]))
    95	    with registry.tx() as c:
    96	        for node in nodes:
    97	            for table in ("source_status", "cursors", "gaps"):
    98	                c.execute(f"DELETE FROM {table} WHERE node_id = ?", (node["id"],))
    99	        c.execute("DELETE FROM nodes WHERE cluster_id = ?", (cluster_id,))
   100	        c.execute("DELETE FROM clusters WHERE id = ?", (cluster_id,))

