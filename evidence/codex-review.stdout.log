   147	    if (sorted.length) {
   148	      // Break the line where buckets have no samples instead of bridging the hole.
   149	      const d = sorted.map((p, i) => `${i && p.t - sorted[i - 1].t <= gapMs ? "L" : "M"}${x(p.t)},${y(p.v)}`).join(" ");
   150	      svg.append(s("path", { d, fill: "none", stroke: "var(--series-1)", "stroke-width": 2, "stroke-linejoin": "round" }));
   151	      for (const p of sorted) svg.append(s("circle", { cx: x(p.t), cy: y(p.v), r: 4, fill: "var(--series-1)", stroke: "var(--surface-1)", "stroke-width": 2 }));
   152	    }
   153	    const tip = tooltip(container);
   154	    const hair = s("line", { y1: M.top, y2: M.top + PH, stroke: "var(--text-muted)", "stroke-width": 1, visibility: "hidden" });
   155	    svg.append(hair);
   156	    const hit = s("rect", { x: M.left, y: M.top, width: PW, height: PH, fill: "transparent" });
   157	    hit.addEventListener("pointermove", (e) => {
   158	      if (!sorted.length) return;
   159	      const box = svg.getBoundingClientRect();
   160	      const t = from + ((e.clientX - box.left) / box.width * W - M.left) / PW * (to - from);
   161	      const near = sorted.reduce((a, b) => (Math.abs(b.t - t) < Math.abs(a.t - t) ? b : a));
   162	      hair.setAttribute("x1", x(near.t));
   163	      hair.setAttribute("x2", x(near.t));
   164	      hair.setAttribute("visibility", "visible");
   165	      tip.show(e, [{ text: hhmm(near.t) }, { text: `${fmt(near.v)}${near.note ? ` (${near.note})` : ""}`, strong: true, color: "var(--series-1)" }, { text: label }]);
   166	    });
   167	    hit.addEventListener("pointerleave", () => { hair.setAttribute("visibility", "hidden"); tip.hide(); });
   168	    svg.append(hit);
   169	  }
   170	
   171	  function sparkline(container, { points, from, to }) {
   172	    while (container.firstChild) container.removeChild(container.firstChild);
   173	    const w = 220, h = 44;
   174	    const svg = s("svg", { viewBox: `0 0 ${w} ${h}`, role: "img", "aria-hidden": "true" });
   175	    const vals = points.map((p) => p.v);
   176	    const lo = Math.min(...vals, 0), hi = Math.max(...vals, 1);
   177	    const px = (t) => ((t - from) / (to - from)) * (w - 4) + 2;
   178	    const py = (v) => h - 4 - ((v - lo) / (hi - lo || 1)) * (h - 8);
   179	    const sorted = points.slice().sort((a, b) => a.t - b.t);
   180	    if (sorted.length) {
   181	      svg.append(s("path", { d: sorted.map((p, i) => `${i ? "L" : "M"}${px(p.t)},${py(p.v)}`).join(" "), fill: "none", stroke: "var(--series-1)", "stroke-width": 2 }));
   182	    }
   183	    container.append(svg);
   184	  }
   185	
   186	  return { stackedBars, line, sparkline };
   187	})();

