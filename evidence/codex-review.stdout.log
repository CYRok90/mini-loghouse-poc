     1	// Shared helpers. Every dynamic string is inserted with textContent (never innerHTML):
     2	// cluster names, SQL text and server error messages are untrusted data.
     3	"use strict";
     4	
     5	const MLH = (() => {
     6	  const JSON_HEADERS = { "Content-Type": "application/json", "X-MLH-Request": "1" };
     7	
     8	  async function api(path, options = {}) {
     9	    const method = options.method || (options.body !== undefined ? "POST" : "GET");
    10	    const init = { method, headers: {}, cache: "no-store" };
    11	    if (options.body !== undefined) {
    12	      init.headers = { ...JSON_HEADERS };
    13	      init.body = JSON.stringify(options.body);
    14	    } else if (init.method !== "GET") {
    15	      init.headers = { "X-MLH-Request": "1" };
    16	    }
    17	    let response;
    18	    try {
    19	      response = await fetch(path, init);
    20	    } catch (_) {
    21	      return { ok: false, status: 0, data: null };
    22	    }
    23	    let data = null;
    24	    try {
    25	      data = await response.json();
    26	    } catch (_) {
    27	      data = null;
    28	    }
    29	    return { ok: response.ok, status: response.status, data };
    30	  }
    31	
    32	  function el(tag, attrs = {}, ...children) {
    33	    const node = document.createElement(tag);
    34	    for (const [key, value] of Object.entries(attrs)) {
    35	      if (value === undefined || value === null || value === false) continue;
    36	      if (key === "class") node.className = value;
    37	      else if (key === "text") node.textContent = String(value);
    38	      else if (key.startsWith("on")) node.addEventListener(key.slice(2), value);
    39	      else node.setAttribute(key, value === true ? "" : String(value));
    40	    }
    41	    for (const child of children.flat()) {
    42	      if (child === null || child === undefined || child === false) continue;
    43	      node.append(child instanceof Node ? child : document.createTextNode(String(child)));
    44	    }
    45	    return node;
    46	  }
    47	
    48	  function clear(node) {
    49	    while (node.firstChild) node.removeChild(node.firstChild);
    50	    return node;
    51	  }
    52	
    53	  const tzName = Intl.DateTimeFormat().resolvedOptions().timeZone;
    54	  function tzLabel() {
    55	    const offset = -new Date().getTimezoneOffset();
    56	    const sign = offset >= 0 ? "+" : "-";
    57	    const hh = String(Math.floor(Math.abs(offset) / 60)).padStart(2, "0");
    58	    const mm = String(Math.abs(offset) % 60).padStart(2, "0");
    59	    return `${tzName} (UTC${sign}${hh}:${mm})`;
    60	  }
    61	
    62	  function fmtTime(ms, withDate = false) {
    63	    if (!ms) return "—";
    64	    const d = new Date(ms);
    65	    const opts = { hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false };
    66	    if (withDate) Object.assign(opts, { year: "numeric", month: "2-digit", day: "2-digit" });
    67	    return d.toLocaleString("ko-KR", opts);
    68	  }
    69	
    70	  function fmtAge(ms) {
    71	    if (!ms) return "—";
    72	    const sec = Math.max(0, Math.round((Date.now() - ms) / 1000));
    73	    if (sec < 60) return `${sec}초 전`;
    74	    if (sec < 3600) return `${Math.floor(sec / 60)}분 ${sec % 60}초 전`;
    75	    return `${Math.floor(sec / 3600)}시간 ${Math.floor((sec % 3600) / 60)}분 전`;
    76	  }
    77	
    78	  function fmtNum(value) {
    79	    if (value === null || value === undefined) return "—";
    80	    return Number(value).toLocaleString("ko-KR");
    81	  }
    82	
    83	  function fmtBytes(value) {
    84	    const n = Number(value);
    85	    if (!Number.isFinite(n)) return "—";
    86	    const units = ["B", "KiB", "MiB", "GiB", "TiB"];
    87	    let v = Math.abs(n);
    88	    let i = 0;
    89	    while (v >= 1024 && i < units.length - 1) { v /= 1024; i += 1; }
    90	    return `${n < 0 ? "-" : ""}${v.toFixed(i ? 1 : 0)} ${units[i]}`;
    91	  }
    92	
    93	  // Collection states (server vocabulary) -> badge with icon + label (never color alone).
    94	  const STATE_ICON = { collecting: "●", waiting_first: "◌", preparing: "…", delayed: "▲", error: "✕" };
    95	  function stateBadge(state, label) {
    96	    return el("span", { class: `badge state-${state}` }, el("span", { class: "badge-icon", "aria-hidden": "true", text: STATE_ICON[state] || "?" }), label);
    97	  }
    98	
    99	  function errorText(error) {
   100	    if (!error) return "";
   101	    const codes = error.codes && error.codes.length ? ` (code ${error.codes.join(", ")})` : "";
   102	    return `${error.message}${codes}`;
   103	  }
   104	
   105	  return { api, el, clear, tzLabel, fmtTime, fmtAge, fmtNum, fmtBytes, stateBadge, errorText };
   106	})();

