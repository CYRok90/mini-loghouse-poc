     1	"""Runtime settings. Every value has a safe default; env overrides are validated."""
     2	
     3	from __future__ import annotations
     4	
     5	import os
     6	from dataclasses import dataclass
     7	from pathlib import Path
     8	
     9	PROJECT_ROOT = Path(__file__).resolve().parent.parent
    10	
    11	
    12	def _int_env(name: str, default: int, low: int, high: int) -> int:
    13	    raw = os.environ.get(name)
    14	    if raw is None:
    15	        return default
    16	    value = int(raw)
    17	    if not low <= value <= high:
    18	        raise ValueError(f"{name} must be within [{low}, {high}]")
    19	    return value
    20	
    21	
    22	def _path_env(name: str, default: Path) -> Path:
    23	    raw = os.environ.get(name)
    24	    return Path(raw).expanduser().resolve() if raw else default
    25	
    26	
    27	@dataclass(frozen=True)
    28	class Settings:
    29	    data_dir: Path
    30	    key_file: Path
    31	    tls_ca_file: Path | None
    32	    bind_host: str
    33	    port: int
    34	    refresh_seconds: int  # RMV period for metrics and query_log
    35	    safety_lag_seconds: int  # query_log async flush allowance
    36	    overlap_seconds: int  # extra re-read window per refresh
    37	    initial_backfill_seconds: int  # history fetched right after registration
    38	    max_backfill_seconds: int  # older gaps are recorded as unrecoverable
    39	    backfill_chunk_seconds: int
    40	    probe_timeout_seconds: int
    41	    supervisor_poll_seconds: int
    42	    collector_tag: str  # log_comment marking our own queries on the sources
    43	
    44	    @property
    45	    def chdb_path(self) -> Path:
    46	        return self.data_dir / "chdb"
    47	
    48	    @property
    49	    def registry_path(self) -> Path:
    50	        return self.data_dir / "registry.sqlite3"
    51	
    52	    @property
    53	    def lock_path(self) -> Path:
    54	        return self.data_dir / "app.lock"
    55	
    56	    @property
    57	    def chdb_config_path(self) -> Path:
    58	        return self.data_dir / "chdb-config.xml"
    59	
    60	    @property
    61	    def query_window_seconds(self) -> int:
    62	        """Length of the re-read window [now - lag - window, now - lag)."""
    63	        return self.refresh_seconds + self.overlap_seconds
    64	
    65	    @property
    66	    def stale_after_seconds(self) -> int:
    67	        """No successful refresh for this long => '수집 지연'."""
    68	        return 3 * self.refresh_seconds + self.safety_lag_seconds
    69	
    70	
