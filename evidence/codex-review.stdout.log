    99	# --------------------------------------------------------------------------- dashboard
   100	def _where(node_id: str | None, time_col: str) -> str:
   101	    node = " AND node_id = {nid:String}" if node_id else ""
   102	    if time_col == "event_time":
   103	        span = "event_time >= toDateTime({f:UInt32}) AND event_time < toDateTime({t:UInt32})"
   104	    else:
   105	        span = f"{time_col} >= toDateTime64({{f:UInt32}}, 3) AND {time_col} < toDateTime64({{t:UInt32}}, 3)"
   106	    return f" WHERE cluster_id = {{cid:String}} AND {span}{node}"
   107	
   108	
   109	def _query_sections(owner: ChdbOwner, params: dict, node_id: str | None) -> dict[str, Any]:
   110	    w = _where(node_id, "event_time")
   111	    src = "FROM telemetry.query_log_v"
   112	    summary = owner.rows(
   113	        "SELECT countIf(is_initial_query = 1 AND type != 'QueryStart') AS initial_queries,"
   114	        f" countIf(is_initial_query = 1 AND type IN {EXCEPTIONS}) AS initial_failed,"
   115	        " countIf(type != 'QueryStart') AS node_events, countIf(type = 'QueryStart') AS query_start_rows,"
   116	        " quantileExactIf(0.95)(query_duration_ms, is_initial_query = 1 AND type = 'QueryFinish') AS p95_ms,"
   117	        f" countIf(is_initial_query = 1 AND type = 'QueryFinish') AS p95_samples {src}{w}{_LIMITS}", params)[0]
   118	    series = owner.rows(
   119	        "SELECT toUnixTimestamp(toStartOfInterval(event_time, toIntervalSecond({b:UInt32}))) AS bucket,"
   120	        " countIf(is_initial_query = 1 AND type != 'QueryStart') AS queries,"
   121	        f" countIf(is_initial_query = 1 AND type IN {EXCEPTIONS}) AS failed,"
   122	        " quantileExactIf(0.95)(query_duration_ms, is_initial_query = 1 AND type = 'QueryFinish') AS p95_ms,"
   123	        f" countIf(is_initial_query = 1 AND type = 'QueryFinish') AS ok_samples {src}{w}"
   124	        f" GROUP BY bucket ORDER BY bucket{_LIMITS}", params)
   125	    cols = ("node_id, source_display_name, toUnixTimestamp64Milli(event_time_microseconds) AS ts_ms, query_id, type,"
   126	            " is_initial_query, user, query_duration_ms, read_rows, exception_code,"
   127	            " substring(exception, 1, 300) AS exception, substring(query, 1, 2000) AS query")
   128	    tables = {
   129	        "recent": f"SELECT {cols} {src}{w} AND type != 'QueryStart' ORDER BY event_time_microseconds DESC LIMIT 50",
   130	        "slow": f"SELECT {cols} {src}{w} AND type = 'QueryFinish' ORDER BY query_duration_ms DESC LIMIT 20",
   131	        "errors": f"SELECT {cols} {src}{w} AND type IN {EXCEPTIONS} ORDER BY event_time_microseconds DESC LIMIT 20",
   132	    }
   133	    return {
   134	        "summary": {**summary, "p95_ms": summary["p95_ms"] if int(summary["p95_samples"]) else None},
   135	        "series": [{**r, "p95_ms": r["p95_ms"] if int(r["ok_samples"]) else None} for r in series],
   136	        "tables": {k: owner.rows(sql + _LIMITS, params) for k, sql in tables.items()},
   137	    }
   138	
   139	
   140	def _metric_sections(owner: ChdbOwner, params: dict, node_id: str | None) -> dict[str, Any]:
   141	    p = params
   142	    node = " AND node_id = {nid:String}" if node_id else ""
   143	    current = owner.rows(
   144	        "SELECT node_id, any(source_display_name) AS display_name, metric, argMax(value, collected_at) AS value,"
   145	        " toUnixTimestamp64Milli(max(collected_at)) AS at_ms FROM telemetry.metrics_raw"
   146	        f" WHERE cluster_id = {{cid:String}}{node} AND metric IN {_METRIC_SET}"
   147	        " AND collected_at >= now64(3) - INTERVAL 1 DAY GROUP BY node_id, metric ORDER BY metric, node_id" + _LIMITS, p)
   148	    series = owner.rows(
   149	        "SELECT bucket, metric, sum(v) AS value, count() AS nodes FROM ("
   150	        " SELECT toUnixTimestamp(toStartOfInterval(collected_at, toIntervalSecond({b:UInt32}))) AS bucket, node_id, metric,"
   151	        f" max(value) AS v FROM telemetry.metrics_raw{_where(node_id, 'collected_at')} AND metric IN {_METRIC_SET}"
   152	        " GROUP BY bucket, node_id, metric) GROUP BY bucket, metric ORDER BY bucket" + _LIMITS, p)
   153	    return {"current": current, "series": series, "curated": list(CURATED_METRICS)}
   154	
   155	
   156	def _coverage(registry: Registry, node_ids: list[str]) -> dict[str, Any]:
   157	    out = {}
   158	    gaps = registry.gaps(node_ids)
   159	    for nid in node_ids:
   160	        cursor = registry.cursor(nid)
   161	        node_gaps = [g for g in gaps if g["node_id"] == nid]
   162	        backfilled_lo = [g["lo"] for g in node_gaps if g["state"] == "backfilled"]
   163	        starts = ([cursor["first_lo"]] if cursor else []) + backfilled_lo
   164	        out[nid] = {
   165	            "collected_from_ms": _ms(min(starts)) if starts else None,
   166	            "committed_hi_ms": _ms(cursor["committed_hi"]) if cursor else None,
   167	            "gaps": [{"lo_ms": _ms(g["lo"]), "hi_ms": _ms(g["hi"]), "state": g["state"], "reason": g["reason"]}
   168	                     for g in node_gaps if g["state"] != "backfilled"],
   169	        }
   170	    return out
   171	
   172	
   173	def dashboard(owner: ChdbOwner, registry: Registry, settings: Settings, cluster: dict,
   174	              range_key: str, node_id: str | None) -> dict[str, Any]:
   175	    span, bucket = RANGES[range_key]
   176	    now = int(time.time())
   177	    params: dict[str, Any] = {"cid": cluster["id"], "f": now - span, "t": now, "b": bucket}
   178	    if node_id:
   179	        params["nid"] = node_id
   180	    node_ids = [node_id] if node_id else [n["id"] for n in registry.nodes(cluster["id"])]
   181	    return {
   182	        "generated_ms": now * 1000, "range": range_key, "from_ms": (now - span) * 1000, "to_ms": now * 1000,
   183	        "bucket_seconds": bucket, "node_id": node_id,
   184	        "queries": _query_sections(owner, params, node_id),
   185	        "metrics": _metric_sections(owner, params, node_id),
   186	        "coverage": _coverage(registry, node_ids),
   187	        "safety_lag_seconds": settings.safety_lag_seconds,
   188	    }
   189	
