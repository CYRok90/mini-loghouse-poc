     1	"""Cluster status views and dashboard aggregations (chDB stored data only).
     2	
     3	Aggregation definitions (also rendered in the UI):
     4	- 기록된 initial 쿼리 수: is_initial_query = 1 AND type != 'QueryStart'
     5	  (QueryFinish + ExceptionBeforeStart + ExceptionWhileProcessing). QueryStart
     6	  is excluded so one query is never counted twice. Client retries with a new
     7	  query_id are separate queries.
     8	- 실패 수: initial rows with type ExceptionBeforeStart / ExceptionWhileProcessing.
     9	- 노드 실행 이벤트 수: all non-QueryStart rows on every node, including the
    10	  is_initial_query = 0 sub-queries a distributed query runs on each shard.
    11	- 성공 쿼리 지연 p95: quantileExact(0.95) of query_duration_ms over initial
    12	  QueryFinish rows (sample count returned; null when there are no samples).
    13	- Dedup: every query reads telemetry.query_log_v (ReplacingMergeTree FINAL) whose
    14	  identity is (cluster, node, event_time_microseconds, type, query_id,
    15	  query_start_time_microseconds). query_id alone is never used to merge.
    16	- Collector's own queries are excluded at collection time (log_comment).
    17	"""
    18	
    19	from __future__ import annotations
    20	
    21	import time
    22	from typing import Any
    23	
    24	from .chdb_owner import ChdbOwner
    25	from .registry import Registry
    26	from .settings import Settings
    27	from .sqlsafe import literal
    28	from .status import STATE_LABEL, coverage_label, worst_state
    29	
    30	RANGES = {"15m": (900, 60), "1h": (3600, 60), "24h": (86400, 1800)}
    31	EXCEPTIONS = "('ExceptionBeforeStart', 'ExceptionWhileProcessing')"
    32	CURATED_METRICS = (
    33	    "Query", "TCPConnection", "HTTPConnection", "MemoryTracking", "Merge",
    34	    "BackgroundMergesAndMutationsPoolTask", "PartsActive", "GlobalThreadActive",
    35	)
    36	_METRIC_SET = "(" + ", ".join(literal(m) for m in CURATED_METRICS) + ")"
    37	_LIMITS = (" SETTINGS max_execution_time = 10, max_result_rows = 200000, result_overflow_mode = 'throw',"
    38	           " output_format_json_quote_64bit_integers = 0")
    39	
    40	
    41	def _ms(ts: float | None) -> int | None:
    42	    return int(ts * 1000) if ts else None
    43	
    44	
    45	# --------------------------------------------------------------------------- status
    46	def node_view(registry: Registry, node: dict) -> dict[str, Any]:
    47	    sources = {s: registry.source_status(node["id"], s) or {} for s in ("metrics", "query_log")}
    48	    states = [sources[s].get("state", "preparing") for s in sources]
    49	    confirmed = node["phase"] == "active" and all(sources[s].get("last_success_at") for s in sources)
    50	    return {
    51	        "id": node["id"], "host": node["host"], "port": node["port"], "display_name": node["display_name"],
    52	        "server_version": node["server_version"], "phase": node["phase"], "confirmed": confirmed,
    53	        "state": worst_state(states), "state_label": STATE_LABEL[worst_state(states)],
    54	        "sources": {s: _source_view(v) for s, v in sources.items()},
    55	    }
    56	
    57	
    58	def _source_view(status: dict) -> dict[str, Any]:
    59	    state = status.get("state", "preparing")
    60	    return {
    61	        "state": state, "state_label": STATE_LABEL[state],
    62	        "last_attempt_ms": _ms(status.get("last_attempt_at")), "last_success_ms": _ms(status.get("last_success_at")),
    63	        "error": {"category": status["last_error_category"], "message": status["last_error_message"],
    64	                  "consecutive_failures": status.get("consecutive_failures", 0)} if status.get("last_error_category") else None,
    65	    }
    66	
    67	
    68	def cluster_view(registry: Registry, settings: Settings, cluster: dict) -> dict[str, Any]:
    69	    nodes = [node_view(registry, n) for n in registry.nodes(cluster["id"])]
    70	    sources = [src for n in nodes for src in n["sources"].values()]
    71	    attempts = [s["last_attempt_ms"] for s in sources if s["last_attempt_ms"]]
    72	    successes = [s["last_success_ms"] for s in sources if s["last_success_ms"]]
    73	    errors = [s["error"] for s in sources if s["state"] == "error" and s["error"]]
    74	    confirmed = sum(1 for n in nodes if n["confirmed"])
    75	    discovered = bool(cluster["discovered_cluster"])
    76	    state = worst_state([n["state"] for n in nodes])
    77	    return {
    78	        "id": cluster["id"], "name": cluster["name"], "host": cluster["host"], "port": cluster["port"],
    79	        "tls": bool(cluster["tls"]), "username": cluster["username"], "server_version": cluster["server_version"],
    80	        "phase": cluster["phase"], "state": state, "state_label": STATE_LABEL[state],
    81	        "last_check": {
    82	            "at_ms": max(attempts) if attempts else _ms(cluster["last_check_at"]),
    83	            "ok": not errors if attempts else bool(cluster["last_check_ok"]),
    84	            "source": "collection" if attempts else "registration_probe",
    85	        },
    86	        "last_success_ms": min(successes) if len(successes) == len(sources) and sources else None,
    87	        "newest_success_ms": max(successes) if successes else None,
    88	        "latest_error": errors[0] if errors else None,
    89	        "coverage": {
    90	            "label": coverage_label(confirmed, cluster["candidate_count"], discovered),
    91	            "confirmed_nodes": confirmed, "registered_nodes": len(nodes),
    92	            "candidate_nodes": cluster["candidate_count"], "discovered_cluster": cluster["discovered_cluster"],
    93	        },
    94	        "stale_after_seconds": settings.stale_after_seconds, "refresh_seconds": settings.refresh_seconds,
    95	        "nodes": nodes,
    96	    }
