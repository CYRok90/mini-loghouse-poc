   100	        return FileResponse(STATIC / "add.html")
   101	
   102	    @app.get("/clusters/{cluster_id}", include_in_schema=False)
   103	    async def cluster_page(cluster_id: str) -> FileResponse:
   104	        if not CLUSTER_ID_RE.fullmatch(cluster_id):
   105	            raise HTTPException(404)
   106	        return FileResponse(STATIC / "cluster.html")
