   208	def init() -> None:
   209	    ensure_certs()
   210	    ensure_secrets()
   211	    for node in NODES.values():
   212	        for sub in ("data", "tmp", "user_files", "log"):
   213	            (node.dir / sub).mkdir(parents=True, exist_ok=True)
   214	        (node.dir / "config.xml").write_text(config_xml(node))
   215	        (node.dir / "users.xml").write_text(users_xml())
   216	    os.chmod(BASE, 0o700)
   217	    print(f"initialized {', '.join(NODES)} under {BASE}")
