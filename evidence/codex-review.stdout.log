     1	// Minimal SVG charts (no external libraries, CSP script-src 'self').
     2	// Colors come from CSS custom properties; text uses text tokens, never series colors.
     3	"use strict";
     4	
     5	const Charts = (() => {
     6	  const NS = "http://www.w3.org/2000/svg";
     7	  const W = 560, H = 220, M = { top: 12, right: 12, bottom: 26, left: 44 };
     8	  const PW = W - M.left - M.right, PH = H - M.top - M.bottom;
     9	
    10	  function s(tag, attrs = {}, text) {
    11	    const node = document.createElementNS(NS, tag);
    12	    for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, String(v));
    13	    if (text !== undefined) node.textContent = String(text);
    14	    return node;
    15	  }
    16	
    17	  // Axis max = 4 x a 1/2/5 step, so the four grid lines land on round numbers.
    18	  function niceMax(v) {
    19	    const raw = Math.max(v, 4) / 4;
    20	    const p = Math.pow(10, Math.floor(Math.log10(raw)));
    21	    const m = raw / p;
    22	    return 4 * (m <= 1 ? 1 : m <= 2 ? 2 : m <= 5 ? 5 : 10) * p;
    23	  }
    24	
    25	  function timeTicks(from, to) {
    26	    const span = to - from;
    27	    const steps = [60e3, 300e3, 600e3, 1800e3, 3600e3, 3 * 3600e3, 6 * 3600e3];
    28	    const step = steps.find((x) => span / x <= 6) || 6 * 3600e3;
    29	    const ticks = [];
    30	    for (let t = Math.ceil(from / step) * step; t <= to; t += step) ticks.push(t);
    31	    return ticks;
    32	  }
    33	
    34	  function hhmm(ms) {
    35	    return new Date(ms).toLocaleTimeString("ko-KR", { hour: "2-digit", minute: "2-digit", hour12: false });
    36	  }
    37	
    38	  function frame(svg, from, to, yMax, yFmt) {
    39	    const x = (t) => M.left + ((t - from) / (to - from)) * PW;
    40	    const y = (v) => M.top + PH - (v / yMax) * PH;
    41	    for (let i = 0; i <= 4; i += 1) {
    42	      const v = (yMax / 4) * i;
    43	      svg.append(s("line", { x1: M.left, x2: M.left + PW, y1: y(v), y2: y(v), stroke: "var(--grid)", "stroke-width": 1 }));
    44	      svg.append(s("text", { x: M.left - 6, y: y(v) + 4, "text-anchor": "end", "font-size": 11, fill: "var(--text-muted)" }, yFmt(v)));
    45	    }
    46	    for (const t of timeTicks(from, to)) {
    47	      svg.append(s("text", { x: x(t), y: H - 8, "text-anchor": "middle", "font-size": 11, fill: "var(--text-muted)" }, hhmm(t)));
    48	    }
    49	    return { x, y };
    50	  }
    51	
    52	  function shadeUncovered(svg, x, from, to, uncovered) {
    53	    for (const u of uncovered || []) {
    54	      const lo = Math.max(from, u.lo), hi = Math.min(to, u.hi);
    55	      if (hi <= lo) continue;
    56	      svg.append(s("rect", { x: x(lo), y: M.top, width: Math.max(1, x(hi) - x(lo)), height: PH, fill: "var(--uncovered)" }));
    57	      if (x(hi) - x(lo) > 40) {
    58	        svg.append(s("text", { x: (x(lo) + x(hi)) / 2, y: M.top + 14, "text-anchor": "middle", "font-size": 11, fill: "var(--text-muted)" }, u.label || "미수집"));
    59	      }
    60	    }
    61	  }
    62	
    63	  function tooltip(wrap) {
    64	    let tip = wrap.querySelector(".tooltip");
    65	    if (!tip) {
    66	      tip = document.createElement("div");
    67	      tip.className = "tooltip";
    68	      tip.hidden = true;
    69	      wrap.append(tip);
    70	    }
    71	    return {
    72	      show(evt, lines) {
    73	        while (tip.firstChild) tip.removeChild(tip.firstChild);
    74	        for (const line of lines) {
    75	          const row = document.createElement("div");
    76	          row.className = "row";
    77	          if (line.color) {
    78	            const sw = document.createElement("span");
