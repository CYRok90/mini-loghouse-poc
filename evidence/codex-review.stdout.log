     1	from dataclasses import replace
     2	
     3	from mlh.settings import load_settings
     4	from mlh.status import advance_cursor, coverage_label, evaluate_source, worst_state
     5	
     6	S = replace(load_settings(), refresh_seconds=15, safety_lag_seconds=10, overlap_seconds=30,
     7	            initial_backfill_seconds=900, max_backfill_seconds=86400)
     8	NODE = {"id": "n000000000001", "phase": "active"}
     9	
    10	
    11	def test_first_success_sets_cursor_and_initial_backfill_gap():
    12	    cursor, gaps = advance_cursor(None, 1000, 1000, S)
    13	    window = S.query_window_seconds  # 45
    14	    assert cursor == (1000 + 1 - 10 - window, 990)
    15	    assert [(g.lo, g.hi, g.state, g.reason) for g in gaps] == [(946 - 900, 946, "pending", "initial")]
    16	
    17	
    18	def test_overlapping_windows_are_contiguous():
    19	    cursor, gaps = advance_cursor({"first_lo": 0, "committed_hi": 990}, 1015, 1015, S)
    20	    assert gaps == [] and cursor == (0, 1005)
    21	
    22	
    23	def test_interruption_longer_than_overlap_creates_gap():
    24	    cursor, gaps = advance_cursor({"first_lo": 0, "committed_hi": 990}, 1200, 1200, S)
    25	    lo_new = 1200 + 1 - 10 - 45
    26	    assert [(g.lo, g.hi, g.state) for g in gaps] == [(990, lo_new, "pending")]
    27	    assert cursor == (0, 1190)
    28	
    29	
    30	def test_gap_older_than_max_backfill_is_unrecoverable():
    31	    now = 200000
    32	    cursor, gaps = advance_cursor({"first_lo": 0, "committed_hi": 1000}, now, now, S)
    33	    assert gaps[0].state == "unrecoverable" and gaps[0].lo == 1000 and gaps[0].hi == now - 86400
    34	    assert gaps[1].state == "pending" and gaps[1].lo == now - 86400
    35	
    36	
    37	def test_old_observation_does_not_move_cursor_backwards():
    38	    assert advance_cursor({"first_lo": 0, "committed_hi": 990}, 990, 2000, S) == (None, [])
    39	
    40	
    41	def test_states():
    42	    ok = evaluate_source(NODE, "metrics", {"last_success_ts": 100, "last_refresh_ts": 100, "exception": ""}, None, 110, S)
    43	    assert ok["state"] == "collecting"
    44	    late = evaluate_source(NODE, "metrics", {"last_success_ts": 100, "last_refresh_ts": 100, "exception": ""}, None, 100 + S.stale_after_seconds + 1, S)
    45	    assert late["state"] == "delayed"
    46	    first = evaluate_source(NODE, "metrics", {"last_success_ts": None, "last_refresh_ts": None, "exception": ""}, None, 100, S)
    47	    assert first["state"] == "waiting_first"
    48	    err = evaluate_source(NODE, "metrics", {"last_success_ts": 90, "last_refresh_ts": 100, "exception": "Connection refused (127.0.0.1:19402)"}, None, 101, S)
    49	    assert err["state"] == "error" and err["last_error_category"] == "refused" and err["consecutive_failures"] == 1
    50	    again = evaluate_source(NODE, "metrics", {"last_success_ts": 90, "last_refresh_ts": 105, "exception": "Connection refused"}, err, 106, S)
    51	    assert again["consecutive_failures"] == 2
    52	
    53	
    54	def test_restart_keeps_persisted_success_when_view_refreshes_resets():
    55	    persisted = {"state": "collecting", "last_success_at": 500, "last_attempt_at": 500, "consecutive_failures": 0}
    56	    st = evaluate_source(NODE, "query_log", {"last_success_ts": None, "last_refresh_ts": None, "exception": ""}, persisted, 505, S)
    57	    assert st["state"] == "collecting" and st["last_success_at"] == 500
    58	
    59	
    60	def test_phase_driven_states():
    61	    assert evaluate_source({**NODE, "phase": "pending"}, "metrics", None, None, 1, S)["state"] == "preparing"
    62	    retry = evaluate_source({**NODE, "phase": "retrying", "last_error_category": "refused", "last_error_message": "m"}, "metrics", None, None, 1, S)
    63	    assert retry["state"] == "error"
    64	
    65	
    66	def test_worst_state_and_coverage():
    67	    assert worst_state(["collecting", "delayed"]) == "delayed"
    68	    assert worst_state(["collecting", "error", "waiting_first"]) == "error"
    69	    assert coverage_label(2, 2, True) == "전체 검증됨"
    70	    assert coverage_label(1, 2, True) == "일부"
    71	    assert coverage_label(1, 0, False) == "미확인"

