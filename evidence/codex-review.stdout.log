     1	"""chDB telemetry schema and per-node collection DDL (RMV).
     2	
     3	Collection path (the original hypothesis under test):
     4	  per node: NC  mlh_<nid>            host/port/user/password (encrypted storage)
     5	            RMV telemetry.mv_m_<nid> REFRESH EVERY R  APPEND -> metrics_raw
     6	            RMV telemetry.mv_q_<nid> REFRESH EVERY R  APPEND -> query_log_raw
     7	query_log RMV re-reads the fixed window [now()-lag-W, now()-lag) every refresh
     8	(W = refresh + overlap). now() is evaluated on chDB and pushed to the source as
     9	a constant (Day-0 evidence). Duplicates from the overlap are expected in raw
    10	and removed by ReplacingMergeTree identity + FINAL in query_log_v.
    11	Downtime longer than the overlap is NOT covered by the RMV; the supervisor
    12	records it as a gap and backfills it explicitly (backfill_sql).
    13	"""
    14	
    15	from __future__ import annotations
    16	
    17	from .settings import Settings
    18	from .sqlsafe import identifier, literal
    19	
    20	DB = "telemetry"
    21	
    22	QUERY_LOG_COLUMNS = (
    23	    "event_date", "event_time", "event_time_microseconds", "query_start_time_microseconds",
    24	    "type", "query_id", "initial_query_id", "is_initial_query", "query_kind", "user",
    25	    "query_duration_ms", "read_rows", "read_bytes", "result_rows", "memory_usage",
    26	    "exception_code", "exception", "query", "normalized_query_hash", "log_comment",
    27	)
    28	
    29	BOOTSTRAP = (
    30	    f"CREATE DATABASE IF NOT EXISTS {DB} ENGINE = Atomic",
    31	    f"""CREATE TABLE IF NOT EXISTS {DB}.metrics_raw (
    32	        cluster_id LowCardinality(String), node_id LowCardinality(String),
    33	        source_display_name LowCardinality(String), collected_at DateTime64(3, 'UTC'),
    34	        metric LowCardinality(String), value Int64
    35	    ) ENGINE = MergeTree
    36	    PARTITION BY toYYYYMMDD(collected_at)
    37	    ORDER BY (cluster_id, node_id, metric, collected_at)
    38	    TTL toDate(collected_at) + INTERVAL 3 DAY""",
    39	    f"""CREATE TABLE IF NOT EXISTS {DB}.query_log_raw (
    40	        cluster_id LowCardinality(String), node_id LowCardinality(String),
    41	        source_display_name LowCardinality(String),
    42	        event_date Date, event_time DateTime('UTC'), event_time_microseconds DateTime64(6, 'UTC'),
    43	        query_start_time_microseconds DateTime64(6, 'UTC'),
    44	        type LowCardinality(String), query_id String, initial_query_id String, is_initial_query UInt8,
    45	        query_kind LowCardinality(String), user LowCardinality(String),
    46	        query_duration_ms UInt64, read_rows UInt64, read_bytes UInt64, result_rows UInt64, memory_usage Int64,
    47	        exception_code Int32, exception String, query String, normalized_query_hash UInt64,
    48	        collected_at DateTime64(3, 'UTC'), collect_path LowCardinality(String)
    49	    ) ENGINE = ReplacingMergeTree(collected_at)
    50	    PARTITION BY toYYYYMMDD(event_time)
    51	    ORDER BY (cluster_id, node_id, event_time_microseconds, type, query_id, query_start_time_microseconds)
    52	    TTL event_date + INTERVAL 7 DAY""",
    53	    # Every dashboard query reads through this deduplicated view.
    54	    f"CREATE VIEW IF NOT EXISTS {DB}.query_log_v AS SELECT * FROM {DB}.query_log_raw FINAL",
    55	)
    56	
    57	_REMOTE_SETTINGS = (
    58	    "connect_timeout_with_failover_ms = 2000, connect_timeout_with_failover_secure_ms = 2000, "
    59	    "connections_with_failover_max_tries = 1, receive_timeout = 15, send_timeout = 15, "
    60	    "max_execution_time = 30"
    61	)
    62	
    63	# Source-side projection. exception/query are truncated at the source.
    64	_QUERY_LOG_SELECT = (
    65	    "event_date, event_time, event_time_microseconds, query_start_time_microseconds, "
    66	    "toString(type) AS type, query_id, initial_query_id, is_initial_query, query_kind, user, "
    67	    "query_duration_ms, read_rows, read_bytes, result_rows, memory_usage, exception_code, "
    68	    "substring(exception, 1, 1000) AS exception, substring(query, 1, 4000) AS query, normalized_query_hash"
    69	)
    70	
    71	
    72	def nc_name(node_id: str) -> str:
    73	    return identifier(f"mlh_{node_id}")
    74	
    75	
    76	def metrics_mv(node_id: str) -> str:
    77	    return identifier(f"mv_m_{node_id}")
    78	
    79	
    80	def query_log_mv(node_id: str) -> str:
    81	    return identifier(f"mv_q_{node_id}")
    82	
    83	
    84	def remote_fn(tls: bool) -> str:
    85	    return "remoteSecure" if tls else "remote"
    86	
    87	
    88	def create_nc_sql(node_id: str, host: str, port: int, username: str, password: str) -> str:
    89	    # CREATE NAMED COLLECTION does not accept query parameters -> validated literals.
    90	    return (
    91	        f"CREATE NAMED COLLECTION IF NOT EXISTS {nc_name(node_id)} AS "
    92	        f"host = {literal(host)}, port = {int(port)}, user = {literal(username)}, password = {literal(password)}"
    93	    )
    94	
    95	
    96	def drop_nc_sql(node_id: str) -> str:
    97	    return f"DROP NAMED COLLECTION IF EXISTS {nc_name(node_id)}"
    98	
    99	
   100	def metrics_mv_sql(settings: Settings, cluster_id: str, node_id: str, tls: bool) -> tuple[str, dict]:
   101	    sql = (
   102	        f"CREATE MATERIALIZED VIEW IF NOT EXISTS {DB}.{metrics_mv(node_id)} "
   103	        f"REFRESH EVERY {int(settings.refresh_seconds)} SECOND APPEND TO {DB}.metrics_raw AS "
   104	        "SELECT {cid:String} AS cluster_id, {nid:String} AS node_id, displayName() AS source_display_name, "
   105	        "now64(3, 'UTC') AS collected_at, metric, value "
   106	        f"FROM {remote_fn(tls)}({nc_name(node_id)}, database = 'system', table = 'metrics') "
   107	        f"SETTINGS log_comment = {literal(settings.collector_tag)}, {_REMOTE_SETTINGS}"
   108	    )
   109	    return sql, {"cid": cluster_id, "nid": node_id}
   110	
   111	
   112	def query_log_mv_sql(settings: Settings, cluster_id: str, node_id: str, tls: bool) -> tuple[str, dict]:
   113	    lag, window = int(settings.safety_lag_seconds), int(settings.query_window_seconds)
   114	    sql = (
   115	        f"CREATE MATERIALIZED VIEW IF NOT EXISTS {DB}.{query_log_mv(node_id)} "
   116	        f"REFRESH EVERY {int(settings.refresh_seconds)} SECOND APPEND TO {DB}.query_log_raw AS "
   117	        "SELECT {cid:String} AS cluster_id, {nid:String} AS node_id, displayName() AS source_display_name, "
   118	        f"{_QUERY_LOG_SELECT}, now64(3, 'UTC') AS collected_at, 'rmv' AS collect_path "
   119	        f"FROM {remote_fn(tls)}({nc_name(node_id)}, database = 'system', table = 'query_log') "
   120	        f"WHERE event_date >= toDate(now() - INTERVAL {lag + window} SECOND) "
   121	        f"AND event_time >= now() - INTERVAL {lag + window} SECOND "
   122	        f"AND event_time < now() - INTERVAL {lag} SECOND "
   123	        f"AND log_comment != {literal(settings.collector_tag)} "
   124	        f"SETTINGS log_comment = {literal(settings.collector_tag)}, {_REMOTE_SETTINGS}"
   125	    )
   126	    return sql, {"cid": cluster_id, "nid": node_id}
   127	
   128	
   129	def backfill_sql(settings: Settings, node_id: str, tls: bool) -> str:
   130	    """Explicit [lo, hi) re-read used for gaps the RMV window cannot cover."""
   131	    return (
   132	        f"INSERT INTO {DB}.query_log_raw "
   133	        "SELECT {cid:String} AS cluster_id, {nid:String} AS node_id, displayName() AS source_display_name, "
   134	        f"{_QUERY_LOG_SELECT}, now64(3, 'UTC') AS collected_at, 'backfill' AS collect_path "
   135	        f"FROM {remote_fn(tls)}({nc_name(node_id)}, database = 'system', table = 'query_log') "
   136	        "WHERE event_date >= toDate(toDateTime({lo:UInt32})) AND event_date <= toDate(toDateTime({hi:UInt32})) "
   137	        "AND event_time >= toDateTime({lo:UInt32}) AND event_time < toDateTime({hi:UInt32}) "
   138	        f"AND log_comment != {literal(settings.collector_tag)} "
   139	        f"SETTINGS log_comment = {literal(settings.collector_tag)}, {_REMOTE_SETTINGS}"
   140	    )
   141	
   142	
   143	def drop_mv_sql(name: str) -> str:
   144	    return f"DROP VIEW IF EXISTS {DB}.{identifier(name)}"

