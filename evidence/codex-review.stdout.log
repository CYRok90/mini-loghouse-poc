   229	
   230	def pid_of(node: Node) -> int | None:
   231	    pid_file = node.dir / "server.pid"
   232	    if not pid_file.exists():
   233	        return None
   234	    pid = int(pid_file.read_text().strip() or 0)
   235	    try:
   236	        os.kill(pid, 0)
   237	    except (ProcessLookupError, PermissionError):
   238	        return None
   239	    return pid
   240	
   241	
   242	def port_open(port: int) -> bool:
   243	    with socket.socket() as sock:
   244	        sock.settimeout(0.5)
   245	        return sock.connect_ex((HOST, port)) == 0
   246	
   247	
   248	def start(names: list[str]) -> None:
   249	    env = node_env()
   250	    for node in (NODES[n] for n in names):
   251	        if pid_of(node):
   252	            print(f"{node.name}: already running")
   253	            continue
   254	        out = open(node.dir / "log" / "stdout.log", "ab")
   255	        proc = subprocess.Popen(
   256	            [str(BINARY), "server", f"--config-file={node.dir / 'config.xml'}"],
   257	            cwd=node.dir, env=env, stdout=out, stderr=out, start_new_session=True,
   258	        )
   259	        (node.dir / "server.pid").write_text(str(proc.pid))
   260	    for node in (NODES[n] for n in names):
   261	        deadline = time.monotonic() + 60
   262	        while time.monotonic() < deadline and not port_open(node.http_port):
   263	            time.sleep(0.5)
   264	        print(f"{node.name}: {'up' if port_open(node.http_port) else 'NOT UP'} pid={pid_of(node)}")
   265	
   266	
   267	def stop(names: list[str]) -> None:
   268	    for node in (NODES[n] for n in names):
   269	        pid = pid_of(node)
   270	        if not pid:
   271	            print(f"{node.name}: not running")
   272	            continue
   273	        os.kill(pid, signal.SIGTERM)
   274	        deadline = time.monotonic() + 30
   275	        while time.monotonic() < deadline and pid_of(node):
   276	            time.sleep(0.5)
   277	        if pid_of(node):
   278	            os.kill(pid, signal.SIGKILL)
   279	        print(f"{node.name}: stopped")
   280	
   281	
   282	def status() -> None:
   283	    for node in NODES.values():
   284	        ports = {"http": node.http_port, "native": node.native_port}
   285	        reach = {k: port_open(v) for k, v in ports.items()}
   286	        print(f"{node.name} cluster={node.cluster} tls={node.tls} pid={pid_of(node)} {ports} reachable={reach}")
   287	
