     1	"""Phase C: correctness and failure recovery against the running test environment.
     2	
     3	Prereqs: scripts/testenv.py start, clusters A (a1,a2) and B (b1) registered.
     4	The script owns the backend process (stop/start) using scripts/dev.env.
     5	
     6	Usage: python experiments/phase_c_resilience.py [c1|c2|c3|c4|c5|all]
     7	Writes evidence/phase_c/<scenario>.json
     8	"""
     9	
    10	from __future__ import annotations
    11	
    12	import json
    13	import os
    14	import signal
    15	import subprocess
    16	import sys
    17	import time
    18	from pathlib import Path
    19	
    20	import httpx
    21	
    22	ROOT = Path(__file__).resolve().parent.parent
    23	sys.path.insert(0, str(ROOT / "scripts"))
    24	import testenv  # noqa: E402
    25	
    26	OUT = ROOT / "evidence" / "phase_c"
    27	BASE = "http://127.0.0.1:8765"
    28	PID_FILE = ROOT / "var" / "backend.pid"
    29	SETTLE = 30  # flush 7.5s + safety lag 8s + 2 refreshes (5s) + margin
    30	
    31	
    32	def env_file() -> dict[str, str]:
    33	    values = {}
    34	    for line in (ROOT / "scripts" / "dev.env").read_text().splitlines():
    35	        if line and not line.startswith("#") and "=" in line:
    36	            k, v = line.split("=", 1)
    37	            values[k] = v
    38	    return {**os.environ, **values}
    39	
    40	
    41	def client() -> httpx.Client:
    42	    return httpx.Client(base_url=BASE, timeout=60)
    43	
    44	
    45	def log(msg: str) -> None:
    46	    print(time.strftime("%H:%M:%S"), msg, flush=True)
    47	
    48	
    49	# ---------------------------------------------------------------- backend control
    50	def backend_alive() -> bool:
    51	    try:
    52	        return client().get("/api/health").status_code == 200
    53	    except httpx.HTTPError:
    54	        return False
    55	
    56	
    57	def backend_stop() -> float:
    58	    pid = int(PID_FILE.read_text())
    59	    started = time.monotonic()
    60	    os.kill(pid, signal.SIGTERM)
    61	    while time.monotonic() - started < 60:
    62	        try:
    63	            os.kill(pid, 0)
    64	        except ProcessLookupError:
    65	            return time.monotonic() - started
    66	        time.sleep(0.2)
    67	    raise RuntimeError("backend did not stop")
    68	
    69	
    70	def backend_start(logname: str = "backend.log") -> subprocess.Popen:
    71	    OUT.mkdir(parents=True, exist_ok=True)
    72	    out = open(OUT / logname, "ab")
    73	    proc = subprocess.Popen([sys.executable, "-m", "mlh"], cwd=ROOT, env=env_file(), stdout=out, stderr=out, start_new_session=True)
    74	    PID_FILE.write_text(str(proc.pid))
    75	    deadline = time.monotonic() + 60
    76	    while time.monotonic() < deadline and not backend_alive():
    77	        time.sleep(0.5)
    78	    return proc
    79	
    80	
    81	# ---------------------------------------------------------------- data helpers
    82	def clusters() -> dict[str, dict]:
    83	    return {c["name"]: c for c in client().get("/api/clusters").json()["clusters"]}
    84	
    85	
    86	def diag(cluster_id: str, prefix: str | None = None) -> dict:
    87	    params = {"prefix": prefix} if prefix else {}
    88	    return client().get(f"/api/clusters/{cluster_id}/diagnostics", params=params).json()
    89	
    90	
    91	def flush_all() -> None:
    92	    for node in testenv.NODES.values():
    93	        if testenv.pid_of(node):
    94	            testenv.http_query(node, "SYSTEM FLUSH LOGS")
    95	
    96	
    97	def source_events(prefix: str, nodes: list[str]) -> set[tuple]:
    98	    sql = ("SELECT displayName() AS node, query_id, toString(type) AS type, toUnixTimestamp64Micro(event_time_microseconds) AS t"
    99	           f" FROM system.query_log WHERE (startsWith(query_id, '{prefix}') OR startsWith(initial_query_id, '{prefix}'))"
   100	           " AND log_comment = 'mlh-testenv' FORMAT JSONEachRow")
   101	    found = set()
   102	    for name in nodes:
   103	        for line in testenv.http_query(testenv.NODES[name], sql).splitlines():
   104	            r = json.loads(line)
   105	            found.add((r["node"], r["query_id"], r["type"], int(r["t"])))
   106	    return found
   107	
   108	
   109	def dest_events(cluster_ids: list[str], prefix: str) -> tuple[set[tuple], dict]:
   110	    found, stats = set(), {}
   111	    for cid in cluster_ids:
   112	        d = diag(cid, prefix)["prefix"]
   113	        stats[cid] = {k: d[k] for k in ("raw_rows", "final_rows", "initial_queries")}
   114	        found |= {(e["node"], e["query_id"], e["type"], int(e["t"])) for e in d["events"]}
   115	    return found, stats
   116	
   117	
   118	def compare(prefix: str, nodes: list[str], cluster_ids: list[str]) -> dict:
   119	    flush_all()
   120	    src = source_events(prefix, nodes)
   121	    dst, stats = dest_events(cluster_ids, prefix)
   122	    return {
   123	        "prefix": prefix, "source_events": len(src), "dest_events": len(dst),
   124	        "missing_in_dest": sorted(map(list, src - dst))[:20], "extra_in_dest": sorted(map(list, dst - src))[:20],
   125	        "dest_stats": stats, "match": src == dst,
   126	    }
   127	
   128	
   129	def save(name: str, data: dict) -> dict:
   130	    OUT.mkdir(parents=True, exist_ok=True)
   131	    (OUT / f"{name}.json").write_text(json.dumps(data, ensure_ascii=False, indent=2))
   132	    log(f"{name}: {json.dumps(data, ensure_ascii=False)[:600]}")
   133	    return data
   134	
   135	
   136	def node_states(name: str) -> dict:
   137	    c = clusters()[name]
   138	    return {"cluster_state": c["state"], "coverage": c["coverage"]["label"],
   139	            "nodes": {n["display_name"]: {s: (v["state"], (v["error"] or {}).get("category")) for s, v in n["sources"].items()} for n in c["nodes"]}}
   140	
   141	
   142	# ---------------------------------------------------------------- scenarios
   143	def c1() -> dict:
   144	    """Reconciliation, raw duplicates, query_id reuse, distributed sub-queries."""
   145	    tag = f"c1x{int(time.time())}"
   146	    testenv.workload(tag, 5)
   147	    a1 = testenv.NODES["a1"]
   148	    reuse = f"{tag}-reuse"
   149	    testenv.http_query(a1, "SELECT 1", reuse)
   150	    testenv.http_query(a1, "SELECT 2", reuse)  # same query_id, different query: must stay 2 events
   151	    testenv.http_query(a1, "SELECT count() FROM clusterAllReplicas('cluster_a', system.one)", f"{tag}-dist")
   152	    time.sleep(SETTLE)
   153	    cl = clusters()
   154	    ids = [cl["cluster-A (TLS)"]["id"], cl["cluster-B"]["id"]]
   155	    result = compare(tag, ["a1", "a2", "b1"], ids)
   156	    a = diag(ids[0], f"{tag}-reuse")["prefix"]["events"]
   157	    dist = diag(ids[0], f"{tag}-dist")["prefix"]["events"]
   158	    result["query_id_reuse_events"] = [(e["query_id"], e["type"]) for e in a]
   159	    result["distributed_events"] = [(e["node"], e["type"], e["is_initial_query"]) for e in dist]
   160	    result["raw_vs_final_all"] = {cid: diag(cid)["per_node"] for cid in ids}
   161	    return save("c1_reconciliation", result)
   162	
   163	
   164	def c2() -> dict:
   165	    """Backend down while sources produce events -> gap + explicit backfill after restart."""
   166	    tag = f"c2x{int(time.time())}"
   167	    before = {name: c["nodes"] for name, c in clusters().items()}
   168	    stop_s = backend_stop()
   169	    log(f"backend stopped in {stop_s:.1f}s; generating {tag} while down")
   170	    testenv.workload(tag, 3)
   171	    down_for = 45
   172	    time.sleep(down_for)
   173	    backend_start("backend-c2.log")
   174	    log("backend restarted; waiting for refresh + backfill")
   175	    time.sleep(SETTLE + 15)
   176	    cl = clusters()
   177	    ids = [cl["cluster-A (TLS)"]["id"], cl["cluster-B"]["id"]]
   178	    result = compare(tag, ["a1", "a2", "b1"], ids)
   179	    result.update({
   180	        "backend_stop_seconds": round(stop_s, 1), "downtime_seconds": down_for,
   181	        "registry_preserved": sorted(before) == sorted(cl), "states_after": {n: node_states(n) for n in cl},
   182	        "gaps": {cid: [g for g in diag(cid)["gaps"] if g["reason"] == "collection_interrupted"][-3:] for cid in ids},
   183	        "credential_reentry_needed": any(n["phase"] == "needs_credentials" for c in cl.values() for n in c["nodes"]),
   184	    })
   185	    return save("c2_backend_restart", result)
   186	
   187	
   188	def c3() -> dict:
   189	    """Stop node a2: a2 error, a1 + cluster B keep collecting, dashboard responsive; then recover."""
   190	    tag = f"c3x{int(time.time())}"
   191	    testenv.stop(["a2"])
   192	    time.sleep(20)
   193	    during = {n: node_states(n) for n in clusters()}
   194	    cl = clusters()
   195	    timings = {}
   196	    for name, c in cl.items():
   197	        t0 = time.monotonic()
   198	        code = client().get(f"/api/clusters/{c['id']}/dashboard", params={"range": "15m"}).status_code
   199	        timings[name] = {"status": code, "seconds": round(time.monotonic() - t0, 3)}
   200	    testenv.workload(f"{tag}-down", 2)  # a1 and b1 only (a2 stopped)
   201	    time.sleep(SETTLE)
   202	    down_cmp = compare(f"{tag}-down", ["a1", "b1"], [cl["cluster-A (TLS)"]["id"], cl["cluster-B"]["id"]])
   203	    testenv.start(["a2"])
   204	    time.sleep(10)
   205	    testenv.workload(f"{tag}-up", 2)
   206	    time.sleep(SETTLE + 15)
   207	    up_cmp = compare(f"{tag}-up", ["a1", "a2", "b1"], [cl["cluster-A (TLS)"]["id"], cl["cluster-B"]["id"]])
   208	    a_id = cl["cluster-A (TLS)"]["id"]
   209	    return save("c3_node_failure", {
   210	        "during_outage": during, "dashboard_during_outage": timings, "collected_while_a2_down": down_cmp,
   211	        "after_recovery": {n: node_states(n) for n in clusters()}, "collected_after_recovery": up_cmp,
   212	        "a_transitions": client().get(f"/api/clusters/{a_id}").json()["transitions"][:8],
   213	        "a_gaps": diag(a_id)["gaps"][-4:],
   214	    })
   215	
   216	
   217	def c4() -> dict:
   218	    """No duplicate collectors: second backend refused; page loads/tabs do not create RMVs."""
   219	    cl = clusters()
   220	    views_before = {n: sorted(diag(c["id"])["collection_views"]) for n, c in cl.items()}
   221	    second = subprocess.run([sys.executable, "-m", "mlh"], cwd=ROOT, env=env_file(), capture_output=True, text=True, timeout=60)
   222	    lines = [ln for ln in (second.stdout + second.stderr).splitlines() if "another mini-loghouse backend" in ln or "startup failed" in ln.lower()]
   223	    c = client()
   224	    for _ in range(10):  # simulate many tabs / auto-refresh
   225	        for name, item in cl.items():
   226	            c.get("/"); c.get(f"/clusters/{item['id']}")
   227	            c.get(f"/api/clusters/{item['id']}"); c.get(f"/api/clusters/{item['id']}/dashboard", params={"range": "1h"})
   228	    views_after = {n: sorted(diag(i["id"])["collection_views"]) for n, i in cl.items()}
   229	    return save("c4_no_duplicates", {
   230	        "second_instance_exit_code": second.returncode, "second_instance_log": lines[:3],
   231	        "original_still_serving": backend_alive(), "views_before": views_before, "views_after": views_after,
   232	        "views_unchanged": views_before == views_after,
   233	    })
   234	
   235	
   236	def c5() -> dict:
   237	    """Plaintext secret scan over data dir, logs, evidence and API responses."""
   238	    secrets_ = json.loads((ROOT / "var" / "testenv" / "secrets.json").read_text())
   239	    marks = {k: v.encode() for k, v in secrets_.items()}
   240	    roots = [ROOT / "var" / "app", ROOT / "evidence", ROOT / "mlh"]
   241	    hits = []
   242	    for root in roots:
   243	        for path in root.rglob("*"):
   244	            if path.is_file():
   245	                data = path.read_bytes()
   246	                hits += [f"{path.relative_to(ROOT)}:{k}" for k, m in marks.items() if m in data]
   247	    c = client()
   248	    api_text = "".join(c.get(u).text for u in ["/api/clusters", "/api/health"] +
   249	                       [f"/api/clusters/{x['id']}/dashboard" for x in clusters().values()] +
   250	                       [f"/api/clusters/{x['id']}/diagnostics" for x in clusters().values()])
   251	    nc_files = sorted(str(p.relative_to(ROOT)) for p in (ROOT / "var" / "app" / "chdb" / "named_collections").glob("*"))
   252	    return save("c5_secret_scan", {
   253	        "plaintext_hits": hits, "api_hits": [k for k, m in marks.items() if m.decode() in api_text],
   254	        "named_collection_files": nc_files, "scanned_roots": [str(r.relative_to(ROOT)) for r in roots],
   255	    })
   256	
   257	
   258	if __name__ == "__main__":
   259	    which = sys.argv[1] if len(sys.argv) > 1 else "all"
   260	    steps = {"c1": c1, "c2": c2, "c3": c3, "c4": c4, "c5": c5}
   261	    for key, fn in steps.items():
   262	        if which in (key, "all"):
   263	            log(f"== {key} ==")
   264	            fn()

--- scripts/testenv.py ---
     1	"""Local ClickHouse test sources owned by this PoC (loopback only).
     2	
     3	Topology
     4	  cluster_a : a1, a2  (TLS native port, self-signed CA, 2 shards)
     5	  cluster_b : b1      (plaintext native port; isolated local test only)
     6	
     7	Every node has three users. Passwords are random and stored only in
     8	var/testenv/secrets.json (0600, gitignored):
     9	  admin          full access, used by the workload generator
    10	  mlh_collector  SELECT on system.metrics / system.query_log / system.clusters
    11	  mlh_noperm     SELECT on system.one only (permission-denied scenario)
    12	
    13	Commands
    14	  init                 create CA/cert, configs, secrets (idempotent)
    15	  start [node...]      start nodes (default: all)
    16	  stop  [node...]      stop nodes (default: all)
    17	  status               show pid / port reachability
    18	  workload <tag> [n]   run n tagged queries on every running node via HTTP
    19	  sql <node> <query>   run one query as admin via HTTP (prints TSV)
    20	"""
    21	
    22	from __future__ import annotations
    23	
    24	import json
    25	import os
    26	import secrets
    27	import signal
    28	import socket
    29	import subprocess
    30	import sys
    31	import time
    32	import urllib.error
    33	import urllib.parse
    34	import urllib.request
    35	from dataclasses import dataclass
    36	from pathlib import Path
    37	
    38	ROOT = Path(__file__).resolve().parent.parent
    39	BINARY = ROOT / ".tools" / "clickhouse"
    40	BASE = ROOT / "var" / "testenv"
    41	CERTS = BASE / "certs"
    42	SECRETS_FILE = BASE / "secrets.json"
    43	HOST = "127.0.0.1"
    44	
    45	
    46	@dataclass(frozen=True)
    47	class Node:
    48	    name: str
    49	    cluster: str
    50	    http_port: int
    51	    tcp_port: int
    52	    tcp_secure_port: int | None
    53	
    54	    @property
    55	    def native_port(self) -> int:
    56	        return self.tcp_secure_port or self.tcp_port
    57	
    58	    @property
    59	    def tls(self) -> bool:
    60	        return self.tcp_secure_port is not None
    61	
    62	    @property
    63	    def dir(self) -> Path:
    64	        return BASE / self.name
    65	
    66	
    67	NODES = {
    68	    "a1": Node("a1", "cluster_a", 18001, 19001, 19401),
    69	    "a2": Node("a2", "cluster_a", 18002, 19002, 19402),
    70	    "b1": Node("b1", "cluster_b", 18003, 19003, None),
    71	}
    72	
    73	
    74	def run(cmd: list[str]) -> None:
    75	    subprocess.run(cmd, check=True, capture_output=True)
    76	
    77	
    78	def ensure_certs() -> None:
    79	    CERTS.mkdir(parents=True, exist_ok=True)
    80	    ca_key, ca_pem = CERTS / "ca.key", CERTS / "ca.pem"
    81	    srv_key, srv_csr, srv_pem = CERTS / "server.key", CERTS / "server.csr", CERTS / "server.pem"
    82	    ext = CERTS / "server.ext"
    83	    if srv_pem.exists():
    84	        return
    85	    run(["openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes", "-days", "30",
    86	         "-subj", "/CN=mini-loghouse-test-ca", "-keyout", str(ca_key), "-out", str(ca_pem)])
    87	    ext.write_text("subjectAltName=DNS:localhost,IP:127.0.0.1\nextendedKeyUsage=serverAuth\n")
    88	    run(["openssl", "req", "-newkey", "rsa:2048", "-nodes", "-subj", "/CN=localhost",
    89	         "-keyout", str(srv_key), "-out", str(srv_csr)])
    90	    run(["openssl", "x509", "-req", "-in", str(srv_csr), "-CA", str(ca_pem), "-CAkey", str(ca_key),
    91	         "-CAcreateserial", "-days", "30", "-extfile", str(ext), "-out", str(srv_pem)])
    92	    for key in (ca_key, srv_key):
    93	        key.chmod(0o600)
    94	
    95	
    96	def load_secrets() -> dict[str, str]:
    97	    return json.loads(SECRETS_FILE.read_text())
    98	
    99	
   100	def ensure_secrets() -> dict[str, str]:
   101	    if SECRETS_FILE.exists():
   102	        return load_secrets()
   103	    values = {user: secrets.token_urlsafe(18) for user in ("admin", "mlh_collector", "mlh_noperm")}
   104	    SECRETS_FILE.parent.mkdir(parents=True, exist_ok=True)
   105	    fd = os.open(SECRETS_FILE, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
   106	    with os.fdopen(fd, "w") as fh:
   107	        json.dump(values, fh)
   108	    return values
   109	
