--- mlh/__main__.py ---
     1	"""Run the backend: python -m mlh
     2	
     3	Single process, single worker, no auto-reload: the process owns the chDB data
     4	directory (flock) and every RMV, so it must not be duplicated.
     5	"""
     6	
     7	from __future__ import annotations
     8	
     9	import logging
    10	import sys
    11	
    12	import uvicorn
    13	
    14	from .api import create_app
    15	from .chdb_owner import AlreadyRunning
    16	from .settings import load_settings
    17	
    18	
    19	def main() -> int:
    20	    logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(name)s: %(message)s")
    21	    settings = load_settings()
    22	    try:
    23	        uvicorn.run(create_app(settings), host=settings.bind_host, port=settings.port,
    24	                    workers=1, reload=False, log_level="info", server_header=False)
    25	    except AlreadyRunning as exc:
    26	        logging.getLogger("mlh").error("%s", exc)
    27	        return 1
    28	    return 0
    29	
    30	
    31	if __name__ == "__main__":
    32	    sys.exit(main())

