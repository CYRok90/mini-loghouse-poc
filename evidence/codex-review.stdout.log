    96	  }
    97	
    98	  function topRoundedBar(x, y, w, h, r) {
    99	    if (h <= 0) return "";
   100	    const rr = Math.min(r, w / 2, h);
   101	    return `M${x},${y + h} V${y + rr} Q${x},${y} ${x + rr},${y} H${x + w - rr} Q${x + w},${y} ${x + w},${y + rr} V${y + h} Z`;
   102	  }
   103	
   104	  function mount(container) {
