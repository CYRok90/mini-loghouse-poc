    56	        return {**base, "state": "preparing", "last_error_category": None, "last_error_message": None}
    57	    return {**base, "state": "error", "last_error_category": node.get("last_error_category"),
    58	            "last_error_message": node.get("last_error_message")}
    59	
    60	
    61	def evaluate_source(node: dict, source: str, refresh: dict | None, persisted: dict | None,
    62	                    now: float, settings: Settings) -> dict[str, Any]:
    63	    by_phase = _phase_status(node, source, persisted, now)
    64	    if by_phase is not None:
    65	        return by_phase
    66	    prev = persisted or {}
    67	    if refresh is None:
    68	        return {"node_id": node["id"], "source": source, "state": "preparing",
    69	                "last_attempt_at": prev.get("last_attempt_at"), "last_success_at": prev.get("last_success_at"),
    70	                "last_error_category": None, "last_error_message": None, "last_error_codes": None,
    71	                "consecutive_failures": 0}
    72	    successes = [t for t in (refresh.get("last_success_ts"), prev.get("last_success_at")) if t]
    73	    last_success = max(successes) if successes else None
    74	    last_attempt = refresh.get("last_refresh_ts") or prev.get("last_attempt_at")
    75	    result = {"node_id": node["id"], "source": source, "last_attempt_at": last_attempt, "last_success_at": last_success}
    76	    if refresh.get("exception"):
    77	        info = classify(refresh["exception"])
    78	        new_attempt = last_attempt != prev.get("last_attempt_at") or prev.get("state") != "error"
    79	        failures = int(prev.get("consecutive_failures") or 0) + (1 if new_attempt else 0)
    80	        return {**result, "state": "error", "last_error_category": info.category, "last_error_message": info.message,
    81	                "last_error_codes": ",".join(map(str, info.codes)), "consecutive_failures": max(failures, 1)}
    82	    if last_success is None:
    83	        state = "waiting_first"
    84	    else:
    85	        state = "collecting" if now - last_success <= settings.stale_after_seconds else "delayed"
    86	    return {**result, "state": state, "last_error_category": None, "last_error_message": None,
    87	            "last_error_codes": None, "consecutive_failures": 0}
    88	
    89	
    90	def status_changed(old: dict | None, new: dict) -> bool:
    91	    if old is None:
    92	        return True
    93	    keys = ("state", "last_attempt_at", "last_success_at", "last_error_category", "consecutive_failures")
    94	    return any(old.get(k) != new.get(k) for k in keys)
    95	
    96	
    97	def advance_cursor(cursor: dict | None, success_ts: int, now: float,
    98	                   settings: Settings) -> tuple[tuple[int, int] | None, list[Gap]]:
    99	    """Return ((first_lo, committed_hi) or None if unchanged, gaps to record)."""
   100	    lag, window = settings.safety_lag_seconds, settings.query_window_seconds
   101	    hi = success_ts - lag
   102	    lo = success_ts + 1 - lag - window
   103	    if cursor is None:
   104	        gaps = [Gap(lo - settings.initial_backfill_seconds, lo, "pending", "initial")] if settings.initial_backfill_seconds else []
   105	        return (lo, hi), gaps
   106	    committed = int(cursor["committed_hi"])
   107	    if hi <= committed:
   108	        return None, []
   109	    gaps: list[Gap] = []
   110	    if lo > committed:
   111	        gap_lo, floor = committed, int(now) - settings.max_backfill_seconds
   112	        if gap_lo < floor:
   113	            gaps.append(Gap(gap_lo, min(floor, lo), "unrecoverable", "older_than_max_backfill"))
   114	            gap_lo = floor
   115	        if lo > gap_lo:
   116	            gaps.append(Gap(gap_lo, lo, "pending", "collection_interrupted"))
   117	    return (int(cursor["first_lo"]), hi), gaps
   118	
   119	
   120	def worst_state(states: list[str]) -> str:
   121	    return max(states, key=lambda s: STATE_RANK.get(s, 0)) if states else "preparing"
   122	
   123	
   124	def coverage_label(confirmed: int, candidates: int, discovered: bool) -> str:
   125	    if not discovered:
   126	        return "미확인"
   127	    return "전체 검증됨" if confirmed >= candidates > 0 else "일부"

--- mlh/supervisor.py ---
     1	"""Background supervisor: observes RMVs, keeps status/cursors, backfills gaps.
     2	
     3	It never collects steady-state data itself (that is the RMVs' job). It only:
     4	  1. reads local system.view_refreshes and persists per-source status to SQLite
     5	     (view_refreshes resets on restart, SQLite keeps history),
     6	  2. advances the query_log coverage cursor and records gaps,
     7	  3. runs explicit backfill for pending gaps, one bounded chunk per tick,
     8	  4. retries RMV creation for nodes whose source was unreachable at setup.
     9	Its lifetime is the backend process, independent of any browser or HTTP request.
    10	"""
    11	
    12	from __future__ import annotations
    13	
    14	import logging
    15	import threading
    16	import time
    17	from typing import Any
    18	
    19	from . import provisioner, schema
    20	from .chdb_owner import ChdbOwner
    21	from .errors import classify_exception
    22	from .registry import Registry
    23	from .settings import Settings
    24	from .status import advance_cursor, evaluate_source, status_changed
    25	
    26	log = logging.getLogger(__name__)
    27	
    28	REFRESH_SQL = (
    29	    "SELECT view, status, toUnixTimestamp(last_success_time) AS last_success_ts, "
    30	    "toUnixTimestamp(last_refresh_time) AS last_refresh_ts, exception, retry "
    31	    "FROM system.view_refreshes WHERE database = {db:String}"
    32	)
    33	MAX_GAP_ATTEMPTS = 10
    34	
    35	
    36	class Supervisor:
    37	    def __init__(self, owner: ChdbOwner, registry: Registry, settings: Settings) -> None:
    38	        self._owner, self._registry, self._settings = owner, registry, settings
    39	        self._stop = threading.Event()
    40	        self._thread = threading.Thread(target=self._loop, name="supervisor", daemon=True)
    41	        self._retry_after: dict[str, float] = {}
    42	
    43	    def start(self) -> None:
    44	        self._thread.start()
    45	
    46	    def stop(self) -> None:
    47	        self._stop.set()
    48	        self._thread.join(timeout=30)
    49	
    50	    def _loop(self) -> None:
    51	        while not self._stop.is_set():
    52	            try:
    53	                self.tick(time.time())
    54	            except Exception:  # noqa: BLE001 - keep supervising; details stay in local log only
    55	                log.exception("supervisor tick failed")
    56	            self._stop.wait(self._settings.supervisor_poll_seconds)
    57	
    58	    def tick(self, now: float) -> None:
    59	        refreshes = {r["view"]: r for r in self._owner.rows(REFRESH_SQL, {"db": schema.DB})}
    60	        for node in self._registry.nodes():
    61	            self._maybe_retry(node, now)
    62	            self._observe(node, "metrics", refreshes.get(schema.metrics_mv(node["id"])), now)
    63	            self._observe(node, "query_log", refreshes.get(schema.query_log_mv(node["id"])), now)
    64	        self._backfill_one(now)
    65	
    66	    def _maybe_retry(self, node: dict, now: float) -> None:
    67	        if node["phase"] != "retrying" or now < self._retry_after.get(node["id"], 0):
    68	            return
    69	        if not provisioner.retry(self._owner, self._registry, self._settings, node):
    70	            self._retry_after[node["id"]] = now + 4 * self._settings.refresh_seconds
    71	
    72	    def _observe(self, node: dict, source: str, refresh: dict | None, now: float) -> None:
    73	        persisted = self._registry.source_status(node["id"], source)
    74	        status = evaluate_source(node, source, refresh, persisted, now, self._settings)
    75	        if status_changed(persisted, status):
    76	            self._registry.upsert_source_status(status)
    77	        success = (refresh or {}).get("last_success_ts")
    78	        previous_success = (persisted or {}).get("last_success_at") or 0
    79	        if source == "query_log" and success and success > previous_success:
    80	            self._advance(node["id"], int(success), now)
    81	
    82	    def _advance(self, node_id: str, success_ts: int, now: float) -> None:
    83	        new_cursor, gaps = advance_cursor(self._registry.cursor(node_id), success_ts, now, self._settings)
    84	        for gap in gaps:
    85	            self._registry.add_gap(node_id, gap.lo, gap.hi, gap.state, gap.reason)
    86	            log.info("node %s gap %s [%s, %s) %s", node_id, gap.state, gap.lo, gap.hi, gap.reason)
    87	        if new_cursor:
    88	            self._registry.save_cursor(node_id, *new_cursor)
    89	
    90	    def _backfill_one(self, now: float) -> None:
    91	        nodes = {n["id"]: n for n in self._registry.nodes()}
    92	        for gap in self._registry.gaps(list(nodes), ("pending",)):
    93	            status = self._registry.source_status(gap["node_id"], "query_log") or {}
    94	            backoff = min(300, 5 * 2 ** int(gap["attempts"]))
    95	            if status.get("state") != "collecting" or (gap["attempts"] and now - gap["updated_at"] < backoff):
    96	                continue
    97	            self._run_chunk(gap, nodes[gap["node_id"]])
    98	            return  # one chunk per tick keeps the shared chDB executor responsive
    99	
   100	    def _run_chunk(self, gap: dict[str, Any], node: dict) -> None:
   101	        cluster = self._registry.cluster(node["cluster_id"])
   102	        if cluster is None:
   103	            return
   104	        lo = int(gap["next_lo"])
   105	        hi = min(int(gap["hi"]), lo + self._settings.backfill_chunk_seconds)
   106	        params = {"cid": node["cluster_id"], "nid": node["id"], "lo": lo, "hi": hi}
   107	        try:
   108	            self._owner.execute(schema.backfill_sql(self._settings, node["id"], bool(cluster["tls"])), params)
   109	        except Exception as exc:  # noqa: BLE001
   110	            attempts = int(gap["attempts"]) + 1
   111	            state = "failed" if attempts >= MAX_GAP_ATTEMPTS else "pending"
   112	            self._registry.update_gap(gap["id"], lo, state, attempts)
   113	            log.warning("backfill node %s [%s,%s) failed: %s", node["id"], lo, hi, classify_exception(exc).category)
   114	            return
   115	        done = hi >= int(gap["hi"])
   116	        self._registry.update_gap(gap["id"], int(gap["hi"]) if done else hi, "backfilled" if done else "pending", 0)

