   107	    container.append(svg);
   108	    return svg;
   109	  }
   110	
   111	  // Stacked bars: ok (series-1) + failed (status-critical), with a 2px surface gap.
   112	  function stackedBars(container, { buckets, from, to, bucketMs, uncovered, ariaLabel }) {
   113	    const svg = mount(container);
   114	    svg.setAttribute("aria-label", ariaLabel);
   115	    const yMax = niceMax(Math.max(0, ...buckets.map((b) => b.ok + b.failed)));
   116	    const { x, y } = frame(svg, from, to, yMax, (v) => Math.round(v).toString());
   117	    shadeUncovered(svg, x, from, to, uncovered);
   118	    const tip = tooltip(container);
   119	    const bw = Math.max(2, x(from + bucketMs) - x(from) - 2);
   120	    for (const b of buckets) {
   121	      const bx = x(b.t) + 1;
   122	      const okTop = y(b.ok);
   123	      const failTop = y(b.ok + b.failed);
   124	      if (b.ok > 0) svg.append(s("path", { d: topRoundedBar(bx, okTop, bw, M.top + PH - okTop, b.failed > 0 ? 0 : 4), fill: "var(--series-1)" }));
   125	      if (b.failed > 0) svg.append(s("path", { d: topRoundedBar(bx, failTop, bw, okTop - failTop - 2, 4), fill: "var(--status-critical)" }));
   126	      const hit = s("rect", { x: bx - 1, y: M.top, width: bw + 2, height: PH, fill: "transparent", tabindex: 0 });
   127	      const lines = [
   128	        { text: `${hhmm(b.t)} ~ ${hhmm(b.t + bucketMs)}` },
   129	        { text: `${b.ok + b.failed}건 (성공 ${b.ok} · 실패 ${b.failed})`, strong: true },
   130	      ];
   131	      hit.addEventListener("pointermove", (e) => tip.show(e, lines));
   132	      hit.addEventListener("pointerleave", () => tip.hide());
   133	      hit.addEventListener("focus", (e) => tip.show({ clientX: e.target.getBoundingClientRect().x, clientY: e.target.getBoundingClientRect().y + 40 }, lines));
   134	      hit.addEventListener("blur", () => tip.hide());
   135	      svg.append(hit);
   136	    }
   137	  }
   138	
   139	  // Single line with crosshair (one series => the title names it, no legend box).
   140	  function line(container, { points, from, to, uncovered, fmt, ariaLabel, label, gapMs = Infinity }) {
   141	    const svg = mount(container);
   142	    svg.setAttribute("aria-label", ariaLabel);
