     5	
     6	WRAP = "Code: 519. DB::NetException: All attempts to get table structure failed. Log: \n\nCode: 279. DB::NetException: All connection tries failed. Log: \n\n{inner}\n\n. (ALL_CONNECTION_TRIES_FAILED) (version 26.9.2.1)\n\n. (NO_REMOTE_SHARD_AVAILABLE)"
     7	
     8	CASES = [
     9	    ("Code: 210. DB::NetException: SSL Exception: error:0A00010B:SSL routines::wrong version number, while writing to socket", "tls_not_tls_endpoint"),
    10	    ("Code: 102. DB::NetException: Unexpected packet from server 127.0.0.1:19401 (expected Hello or Exception, got 21)", "tls_endpoint_plain_client"),
    11	    ("Code: 102. DB::NetException: Unexpected packet from server 127.0.0.1:18003 (expected Hello or Exception, got 72)", "http_endpoint"),
    12	    ("There is no table `system`.`no_such_table` on server: 127.0.0.1:19003", "table_missing"),
    13	    ("Code: 210. DB::NetException: Connection refused (127.0.0.1:1). (NETWORK_ERROR)", "refused"),
    14	    ("Code: 209. DB::NetException: Timeout: connect timed out: 10.255.255.1:9000. (SOCKET_TIMEOUT)", "timeout"),
    15	    ("Code: 198. DB::NetException: Not found address of host: no-such-host.invalid. (DNS_ERROR)", "dns"),
    16	]
    17	
    18	
    19	@pytest.mark.parametrize("inner,category", CASES)
    20	def test_wrapped_remote_errors_use_inner_cause(inner, category):
    21	    assert classify(WRAP.format(inner=inner)).category == category
    22	
    23	
    24	def test_auth_and_access_denied():
    25	    assert classify("Code: 516. DB::Exception: Received from 127.0.0.1:19003. DB::Exception: mlh_collector: Authentication failed. (AUTHENTICATION_FAILED)").category == "auth"
    26	    assert classify("Code: 497. DB::Exception: Received from x. DB::Exception: mlh_noperm: Not enough privileges. (ACCESS_DENIED)").category == "access_denied"
    27	
    28	
    29	def test_unknown_is_unclassified_and_message_is_fixed():
    30	    raw = "Code: 999. DB::Exception: something with password='hunter2'"
    31	    info = classify(raw)
    32	    assert info.category == "unclassified"
    33	    assert "hunter2" not in info.message and info.codes == (999,)

