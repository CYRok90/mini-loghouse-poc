# Test-environment settings (no secrets here). Usage: set -a; source scripts/dev.env; set +a
MLH_DATA_DIR=var/app
MLH_KEY_FILE=var/secrets/nc.key
MLH_TLS_CA_FILE=var/testenv/certs/ca.pem
MLH_PORT=8765
MLH_REFRESH_SECONDS=5
MLH_OVERLAP_SECONDS=15
MLH_SAFETY_LAG_SECONDS=8
MLH_INITIAL_BACKFILL_SECONDS=600
